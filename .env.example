# Copy to .env (which is gitignored) and fill in your keys.
# pnpm bench は実行時にリポジトリルートの .env を自動で読み込みます。
# Claude Code はこのリポジトリの .claude/settings.json で .env への
# Read / cat / grep などをブロックしているので、key の中身は AI が
# 直接覗けません(プロンプト経由で意図的に渡すのは別問題なので注意)。

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_SELF_HOSTED_BASE_URL=http://localhost:11434/v1

# --- Web (web/) build-time vars ---
# Google Analytics 4 measurement ID. Astro inlines PUBLIC_-prefixed env at
# build time, so the value ships in the HTML (not a secret). Leave blank
# (or unset) to disable GA entirely. In CI use a GitHub Actions `vars`.
# PUBLIC_GA_ID=G-XXXXXXXXXX
