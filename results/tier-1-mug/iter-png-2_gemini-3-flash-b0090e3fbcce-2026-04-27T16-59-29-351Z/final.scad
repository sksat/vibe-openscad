$fn = 100;

// マグカップ本体
difference() {
    // 外径 80mm (半径 40mm)、高さ 100mm
    cylinder(h = 100, r = 40);

    // 内側のくり抜き: 肉厚 4mm (半径 40-4=36mm)、底面の厚み 6mm
    // プレビュー時の上面のチラつきを防ぐため、高さは余裕を持たせて配置
    translate([0, 0, 6])
        cylinder(h = 100, r = 36);
}

// 取手: 半径 12mm のリング状 (ドーナツ形)
// 中心高さ 50mm に配置
// 取手の中心を X=52 に配置することで、リングの一部が外壁(X=40)に埋まり、
// かつ内壁(X=36)を突き破らないように設計（52 - 12 - 3.5 = 36.5mm）
translate([52, 0, 50]) 
rotate([90, 0, 0])
rotate_extrude()
translate([12, 0, 0])   // 取手の中心半径 12mm
circle(r = 3.5);        // 取手の断面半径 (持ちやすい太さ)