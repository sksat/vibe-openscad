$fn = 100;

// マグカップ本体
difference() {
    // 外側: 外径 80mm (半径 40mm)、高さ 100mm
    cylinder(h = 100, r = 40);

    // 内側: 肉厚 4mm (半径 40-4=36mm)、底面の厚み 6mm
    // プレビュー時の上面のチラつき（Z-fighting）を防ぐため、高さは少し余分に持たせる
    translate([0, 0, 6])
        cylinder(h = 95, r = 36);
}

// 取手: 半径 12mm のリング状
// カップの外周(r=40)に対し、中心を X=50 に配置することで、
// リングの内側の穴が外壁からしっかり露出するように調整（穴は X=42 から始まる）
translate([50, 0, 50]) 
rotate([90, 0, 0])      // 取手を垂直に立てる
rotate_extrude()
translate([12, 0, 0])   // 取手の中心半径 12mm
circle(r = 4);          // 取手自体の断面半径 (太さ)