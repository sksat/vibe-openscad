{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(rg * .env*)",
      "Bash(awk * .env*)",
      "Bash(sed * .env*)",
      "Bash(xxd .env*)",
      "Bash(od .env*)",
      "Bash(view .env*)",
      "Bash(vim .env*)",
      "Bash(nano .env*)",
      "Bash(printenv ANTHROPIC_API_KEY*)",
      "Bash(printenv OPENAI_API_KEY*)",
      "Bash(printenv GOOGLE_API_KEY*)"
    ]
  }
}
