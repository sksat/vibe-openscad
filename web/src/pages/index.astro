---
import Base from "../layouts/Base.astro";
import RunCard from "../components/RunCard.astro";
import Filters from "../components/Filters.astro";
import { formatCost, getDataset, runCostUsd } from "../lib/dataset.js";

const ds = getDataset();
const totalRuns = ds.runs.size;
const completedTasks = ds.tasks.filter((t) => t.runs.length > 0).length;
let totalCost = 0;
let wastedCost = 0;
let totalDurationMs = 0;
let wastedDurationMs = 0;
let costRunCount = 0;
let successCount = 0;
let failedCount = 0;
for (const r of ds.runs.values()) {
  const c = runCostUsd(r.meta);
  if (c !== null) {
    totalCost += c;
    if (r.meta.status !== "success") wastedCost += c;
    costRunCount++;
  }
  totalDurationMs += r.meta.timing.totalMs;
  if (r.meta.status !== "success") {
    wastedDurationMs += r.meta.timing.totalMs;
    failedCount++;
  } else {
    successCount++;
  }
}
const fmtMin = (ms: number) =>
  ms < 60000 ? `${(ms / 1000).toFixed(1)}s` : `${(ms / 60000).toFixed(1)}m`;

/** Keep only the newest run per matrixId. Inputs already sorted newest-first. */
function dedupeByMatrix<T extends { meta: { matrixId: string } }>(runs: T[]): T[] {
  const seen = new Set<string>();
  const out: T[] = [];
  for (const r of runs) {
    if (seen.has(r.meta.matrixId)) continue;
    seen.add(r.meta.matrixId);
    out.push(r);
  }
  return out;
}

const taskRows = ds.tasks.map((t) => {
  const latest = dedupeByMatrix(t.runs);
  return { task: t.task, latest, older: t.runs.length - latest.length };
});
---

<Base title="vibe-openscad — dashboard">
  <h1>3D 空間認識ベンチマーク</h1>
  <p class="muted">
    複数の AI モデル / ハーネスに同じ課題で OpenSCAD コードを生成させ、結果を横並びで比較する。
  </p>
  <div class="stats">
    <div class="stat">
      <div class="label">課題</div>
      <div class="val">{completedTasks} / {ds.tasks.length}</div>
    </div>
    <div class="stat">
      <div class="label">run</div>
      <div class="val">{totalRuns} <span class="sub">({successCount} ok / {failedCount} fail)</span></div>
    </div>
    <div class="stat">
      <div class="label">累計コスト</div>
      <div class="val">{formatCost(totalCost)}{wastedCost > 0 && <span class="sub wasted"> 内 {formatCost(wastedCost)} は失敗</span>}</div>
    </div>
    <div class="stat">
      <div class="label">累計時間</div>
      <div class="val">{fmtMin(totalDurationMs)}{wastedDurationMs > 0 && <span class="sub wasted"> 内 {fmtMin(wastedDurationMs)} は失敗</span>}</div>
    </div>
  </div>

  <Filters
    models={ds.facets.models.toSorted()}
    harnessKinds={ds.facets.harnessKinds.toSorted()}
    tiers={ds.facets.tiers}
    subagentModels={ds.facets.subagentModels.toSorted()}
  />

  {ds.tasks.length === 0 && (
    <p class="muted">tasks/ にタスク YAML がありません。</p>
  )}

  <div class="task-list">
    {taskRows.map(({ task, latest, older }) => (
      <section class="task-row" data-tier={String(task.tier)}>
        <header>
          <h2>
            <a href={`/tasks/${task.id}`}>{task.title}</a>
            <span class="badge">tier {task.tier}</span>
            <span class="muted task-id">{task.id}</span>
            {older > 0 && (
              <a class="muted older" href={`/tasks/${task.id}`}>+{older} 過去 run</a>
            )}
          </h2>
        </header>
        {latest.length === 0 ? (
          <p class="muted empty">まだ run がありません。<code>pnpm bench run</code> で実行してください。</p>
        ) : (
          <div class="grid">
            {latest.map((run) => <RunCard run={run} tier={task.tier} />)}
          </div>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .task-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .task-row header h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
  }
  .task-row .task-id {
    font-family: var(--mono);
    font-size: 12px;
    margin-left: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .empty {
    font-size: 13px;
    padding: 12px;
    background: var(--bg-2);
    border: 1px dashed var(--line);
    border-radius: 6px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin: 16px 0 28px;
  }
  .stat {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
  }
  .stat .label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stat .val {
    font-family: var(--mono);
    font-size: 18px;
    margin-top: 4px;
  }
  .stat .sub {
    font-size: 12px;
    color: var(--fg-dim);
    font-weight: normal;
  }
  .stat .sub.wasted { color: var(--bad); }
  .older {
    font-family: var(--mono);
    font-size: 12px;
    margin-left: auto;
  }
</style>
