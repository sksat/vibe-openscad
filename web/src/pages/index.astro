---
import Base from "../layouts/Base.astro";
import RunCard from "../components/RunCard.astro";
import ModelTaskCard from "../components/ModelTaskCard.astro";
import Filters from "../components/Filters.astro";
import type { LoadedRun } from "../lib/results.js";
import {
  chainDepthFor,
  chainRootMatrixId,
  effortInfoFor,
  fingerprintByMatrixId,
  formatCost,
  getDataset,
  harnessGroupSlug,
  runCostUsd,
  thinkingInfoFor,
} from "../lib/dataset.js";

const ds = getDataset();
const fpByMatrix = fingerprintByMatrixId(ds.runs.values());
const totalRuns = ds.runs.size;
const completedTasks = ds.tasks.filter((t) => t.runs.length > 0).length;
let totalCost = 0;
let wastedCost = 0;
let totalDurationMs = 0;
let wastedDurationMs = 0;
let costRunCount = 0;
let successCount = 0;
let failedCount = 0;
for (const r of ds.runs.values()) {
  const c = runCostUsd(r.meta);
  if (c !== null) {
    totalCost += c;
    if (r.meta.status !== "success") wastedCost += c;
    costRunCount++;
  }
  totalDurationMs += r.meta.timing.totalMs;
  if (r.meta.status !== "success") {
    wastedDurationMs += r.meta.timing.totalMs;
    failedCount++;
  } else {
    successCount++;
  }
}
const fmtMin = (ms: number) =>
  ms < 60000 ? `${(ms / 1000).toFixed(1)}s` : `${(ms / 60000).toFixed(1)}m`;

/**
 * For each task, fold the run list into one tile per model. The tile shows:
 *
 *   - 1段目: bare (single-shot) run, large
 *   - 2段目以降: 各 iteration strategy の chain (i1, i2, ...) を横一列。
 *               別 strategy が生えたら下に行が追加される(error-text-feedback
 *               などを後付けする想定)。
 *
 * Bare のみの model は素の RunCard。
 */
type ChainStrategy = {
  groupSlug: string;
  tail: LoadedRun;
  iterSteps: Array<{ run: LoadedRun; depth: number }>;
  /** 期待される chain 全長(他モデル含む同 strategy 中の最大 depth)。
   *  未実行の slot は placeholder で埋めて card の幅を揃える。 */
  expectedDepth: number;
};
type VariantRow = {
  familySlug: string;
  expectedLabels: string[];
  variants: Array<{ label: string; run: LoadedRun; isDefault?: boolean }>;
};
type TaskTile =
  | { kind: "single"; key: string; run: LoadedRun }
  | {
      kind: "model-chain";
      key: string;
      bare: LoadedRun;
      strategies: ChainStrategy[];
      variantRows: VariantRow[];
    };

const EFFORT_ORDER = ["minimal", "low", "medium", "high", "max", "xhigh"];
function compareEffortLabel(a: string, b: string): number {
  const ai = EFFORT_ORDER.indexOf(a);
  const bi = EFFORT_ORDER.indexOf(b);
  if (ai !== -1 || bi !== -1) {
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
  }
  return a.localeCompare(b);
}

/**
 * Per task, gather the union of effort labels (default + explicit) seen
 * across all models that support effort. Used to pad each model's effort
 * row to the same width across cards.
 */
function effortLabelsForTask(latestByMatrix: Map<string, LoadedRun>): string[] {
  const set = new Set<string>();
  for (const r of latestByMatrix.values()) {
    const info = effortInfoFor(r.meta);
    if (info) set.add(info.value);
  }
  return [...set].sort(compareEffortLabel);
}

const THINKING_ORDER = ["off", "adaptive", "dynamic"];
function compareThinkingLabel(a: string, b: string): number {
  const ai = THINKING_ORDER.indexOf(a);
  const bi = THINKING_ORDER.indexOf(b);
  if (ai !== -1 || bi !== -1) {
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
  }
  return a.localeCompare(b);
}

function thinkingLabelsForTask(latestByMatrix: Map<string, LoadedRun>): string[] {
  const set = new Set<string>();
  for (const r of latestByMatrix.values()) {
    const info = thinkingInfoFor(r.meta);
    if (info) set.add(info.value);
  }
  return [...set].sort(compareThinkingLabel);
}

/**
 * Per strategy slug, compute the deepest depth seen across all models +
 * tasks. Used to pad iter strips with placeholders so cards align.
 */
const maxDepthByStrategy = (() => {
  const out = new Map<string, number>();
  for (const r of ds.runs.values()) {
    const slug = harnessGroupSlug(r.meta);
    if (!slug.startsWith("iter-")) continue;
    const d = chainDepthFor(r.meta.matrixId, fpByMatrix);
    out.set(slug, Math.max(out.get(slug) ?? 0, d));
  }
  return out;
})();

function buildTileRow(taskRuns: LoadedRun[]): {
  tiles: TaskTile[];
  older: number;
} {
  // taskRuns is already newest-first within (matrixId).
  // 1) Pick the latest run per matrixId.
  const latestByMatrix = new Map<string, LoadedRun>();
  for (const r of taskRuns) {
    if (!latestByMatrix.has(r.meta.matrixId)) {
      latestByMatrix.set(r.meta.matrixId, r);
    }
  }
  const older = taskRuns.length - latestByMatrix.size;

  // 2) Group iter steps by (model, groupSlug) and collect effort entries by
  //    model. Effort entries include both explicit variants (`bare-low/...`)
  //    and the provider-default `bare/...` run when the model supports an
  //    effort knob — both get a slot in the effort row, with a `(default)`
  //    tag on the implicit one.
  const iterBuckets = new Map<
    string,
    { groupSlug: string; runs: LoadedRun[] }
  >();
  const effortEntriesByModel = new Map<
    string,
    Array<{ label: string; run: LoadedRun; isDefault: boolean }>
  >();
  // Thinking variant entries (Anthropic thinking axis).
  const thinkingEntriesByModel = new Map<
    string,
    Array<{ label: string; run: LoadedRun; isDefault: boolean }>
  >();
  for (const r of latestByMatrix.values()) {
    const groupSlug = harnessGroupSlug(r.meta);
    if (groupSlug.startsWith("iter-")) {
      const model = r.meta.model ?? "unknown";
      const key = `${model}::${groupSlug}`;
      const b = iterBuckets.get(key) ?? { groupSlug, runs: [] };
      b.runs.push(r);
      iterBuckets.set(key, b);
    } else {
      const info = effortInfoFor(r.meta);
      if (info) {
        const model = r.meta.model ?? "unknown";
        const list = effortEntriesByModel.get(model) ?? [];
        list.push({ label: info.value, run: r, isDefault: info.isDefault });
        effortEntriesByModel.set(model, list);
      }
      const tInfo = thinkingInfoFor(r.meta);
      if (tInfo) {
        const model = r.meta.model ?? "unknown";
        const list = thinkingEntriesByModel.get(model) ?? [];
        // Dedup by label (newest wins) — same shape as effort.
        const existing = list.find((e) => e.label === tInfo.value);
        if (!existing) {
          list.push({ label: tInfo.value, run: r, isDefault: tInfo.isDefault });
        } else if (existing.run.meta.createdAt < r.meta.createdAt) {
          existing.run = r;
          existing.isDefault = tInfo.isDefault;
        }
        thinkingEntriesByModel.set(model, list);
      }
    }
  }
  const taskEffortLabels = effortLabelsForTask(latestByMatrix);
  const taskThinkingLabels = thinkingLabelsForTask(latestByMatrix);

  // 3) Per model, collect all strategies + the root bare.
  const strategiesByModel = new Map<string, ChainStrategy[]>();
  const bareByModel = new Map<string, LoadedRun>();
  for (const { groupSlug, runs } of iterBuckets.values()) {
    const model = runs[0]?.meta.model ?? "unknown";
    // Find chain tail (max depth, then newest createdAt).
    const sorted = [...runs].sort((a, b) => {
      const da = chainDepthFor(a.meta.matrixId, fpByMatrix);
      const db = chainDepthFor(b.meta.matrixId, fpByMatrix);
      if (da !== db) return db - da;
      return a.meta.createdAt < b.meta.createdAt ? 1 : -1;
    });
    const tail = sorted[0]!;
    // Iter steps depth >= 1 in ascending order.
    const iterSteps = runs
      .map((r) => ({
        run: r,
        depth: chainDepthFor(r.meta.matrixId, fpByMatrix),
      }))
      .sort((a, b) => a.depth - b.depth);
    const list = strategiesByModel.get(model) ?? [];
    list.push({
      groupSlug,
      tail,
      iterSteps,
      expectedDepth: maxDepthByStrategy.get(groupSlug) ?? iterSteps.length,
    });
    strategiesByModel.set(model, list);

    // Walk the chain backward from any iter step to find the root bare.
    const rootMatrixId = chainRootMatrixId(runs[0]!.meta.matrixId, fpByMatrix);
    const root = latestByMatrix.get(rootMatrixId);
    if (root) bareByModel.set(model, root);
  }

  // Track the default-bare run per model (= the main thumb at the top of
  // the card). For effort-supporting models that's the run with
  // isDefault=true; for non-effort models it's any plain bare/X.
  for (const r of latestByMatrix.values()) {
    const slug = harnessGroupSlug(r.meta);
    if (slug.startsWith("iter-")) continue;
    const info = effortInfoFor(r.meta);
    const isDefaultBare = info === null || info.isDefault;
    if (!isDefaultBare) continue;
    const model = r.meta.model ?? "unknown";
    if (!bareByModel.has(model)) bareByModel.set(model, r);
  }

  const tiles: TaskTile[] = [];
  const seenModels = new Set<string>();
  // Helper: build all variant rows (effort + thinking) for a model. Each
  // row is independently aligned across cards via expectedLabels.
  const variantRowsFor = (model: string): VariantRow[] => {
    const rows: VariantRow[] = [];
    const effortEntries = effortEntriesByModel.get(model) ?? [];
    if (effortEntries.length > 0 && taskEffortLabels.length > 0) {
      const sorted = [...effortEntries].sort((a, b) =>
        compareEffortLabel(a.label, b.label),
      );
      rows.push({
        familySlug: "effort",
        expectedLabels: taskEffortLabels,
        variants: sorted.map((e) => ({
          label: e.label,
          run: e.run,
          isDefault: e.isDefault,
        })),
      });
    }
    const thinkingEntries = thinkingEntriesByModel.get(model) ?? [];
    if (thinkingEntries.length > 0 && taskThinkingLabels.length > 0) {
      const sorted = [...thinkingEntries].sort((a, b) =>
        compareThinkingLabel(a.label, b.label),
      );
      rows.push({
        familySlug: "thinking",
        expectedLabels: taskThinkingLabels,
        variants: sorted.map((e) => ({
          label: e.label,
          run: e.run,
          isDefault: e.isDefault,
        })),
      });
    }
    return rows;
  };

  // Models that have iter strategies → multi-row card with iter + effort.
  for (const [model, strategies] of strategiesByModel.entries()) {
    const bare = bareByModel.get(model);
    if (!bare) continue;
    strategies.sort((a, b) => a.groupSlug.localeCompare(b.groupSlug));
    tiles.push({
      kind: "model-chain",
      key: `chain::${bare.meta.matrixId}`,
      bare,
      strategies,
      variantRows: variantRowsFor(model),
    });
    seenModels.add(model);
  }
  // Models with effort or thinking entries but no iter chain.
  const variantOnlyModels = new Set<string>();
  for (const m of effortEntriesByModel.keys()) variantOnlyModels.add(m);
  for (const m of thinkingEntriesByModel.keys()) variantOnlyModels.add(m);
  for (const model of variantOnlyModels) {
    if (seenModels.has(model)) continue;
    const bare = bareByModel.get(model);
    if (!bare) continue;
    tiles.push({
      kind: "model-chain",
      key: `chain::${bare.meta.matrixId}`,
      bare,
      strategies: [],
      variantRows: variantRowsFor(model),
    });
    seenModels.add(model);
  }
  // Bare-only models (no chain & no effort variants — usually models that
  // don't even support an effort knob, e.g. haiku-4-5, sonnet-4-5, gpt-4.1).
  for (const r of latestByMatrix.values()) {
    const slug = harnessGroupSlug(r.meta);
    if (slug.startsWith("iter-")) continue;
    const info = effortInfoFor(r.meta);
    if (info && !info.isDefault) continue; // explicit effort variant — no standalone tile
    const model = r.meta.model ?? "unknown";
    if (seenModels.has(model)) continue;
    tiles.push({
      kind: "single",
      key: `single::${r.meta.matrixId}`,
      run: r,
    });
    seenModels.add(model);
  }

  // Bare-only first (insertion order ≒ YAML order), chain cards after.
  tiles.sort((a, b) => {
    const ka = a.kind === "model-chain" ? 1 : 0;
    const kb = b.kind === "model-chain" ? 1 : 0;
    return ka - kb;
  });
  return { tiles, older };
}

const taskRows = ds.tasks.map((t) => {
  const { tiles, older } = buildTileRow(t.runs);
  return { task: t.task, tiles, older };
});
---

<Base title="vibe-openscad — dashboard">
  <h1>3D 空間認識ベンチマーク</h1>
  <p class="muted">
    複数の AI モデル / ハーネスに同じ課題で OpenSCAD コードを生成させ、結果を横並びで比較する。
  </p>
  <div class="stats">
    <div class="stat">
      <div class="label">課題</div>
      <div class="val">{completedTasks} / {ds.tasks.length}</div>
    </div>
    <div class="stat">
      <div class="label">run</div>
      <div class="val">{totalRuns} <span class="sub">({successCount} ok / {failedCount} fail)</span></div>
    </div>
    <div class="stat">
      <div class="label">累計コスト</div>
      <div class="val">{formatCost(totalCost)}{wastedCost > 0 && <span class="sub wasted"> 内 {formatCost(wastedCost)} は失敗</span>}</div>
    </div>
    <div class="stat">
      <div class="label">累計時間</div>
      <div class="val">{fmtMin(totalDurationMs)}{wastedDurationMs > 0 && <span class="sub wasted"> 内 {fmtMin(wastedDurationMs)} は失敗</span>}</div>
    </div>
  </div>

  <Filters
    models={ds.facets.models.toSorted()}
    harnessKinds={ds.facets.harnessKinds.toSorted()}
    tiers={ds.facets.tiers}
    subagentModels={ds.facets.subagentModels.toSorted()}
  />

  {ds.tasks.length === 0 && (
    <p class="muted">tasks/ にタスク YAML がありません。</p>
  )}

  <div class="task-list">
    {taskRows.map(({ task, tiles, older }) => (
      <section class="task-row" data-tier={String(task.tier)}>
        <header>
          <h2>
            <a href={`/tasks/${task.id}`}>{task.title}</a>
            <span class="badge">tier {task.tier}</span>
            <span class="muted task-id">{task.id}</span>
            {older > 0 && (
              <a class="muted older" href={`/tasks/${task.id}`}>+{older} 過去 run</a>
            )}
          </h2>
        </header>
        {tiles.length === 0 ? (
          <p class="muted empty">まだ run がありません。<code>pnpm bench run</code> で実行してください。</p>
        ) : (
          <div class="grid">
            {tiles.map((tile) =>
              tile.kind === "single" ? (
                <RunCard run={tile.run} tier={task.tier} />
              ) : (
                <ModelTaskCard
                  bare={tile.bare}
                  strategies={tile.strategies}
                  variantRows={tile.variantRows}
                  tier={task.tier}
                />
              ),
            )}
          </div>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .task-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .task-row header h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
  }
  .task-row .task-id {
    font-family: var(--mono);
    font-size: 12px;
    margin-left: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .empty {
    font-size: 13px;
    padding: 12px;
    background: var(--bg-2);
    border: 1px dashed var(--line);
    border-radius: 6px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin: 16px 0 28px;
  }
  .stat {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
  }
  .stat .label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stat .val {
    font-family: var(--mono);
    font-size: 18px;
    margin-top: 4px;
  }
  .stat .sub {
    font-size: 12px;
    color: var(--fg-dim);
    font-weight: normal;
  }
  .stat .sub.wasted { color: var(--bad); }
  .older {
    font-family: var(--mono);
    font-size: 12px;
    margin-left: auto;
  }
</style>
