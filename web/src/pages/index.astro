---
import Base from "../layouts/Base.astro";
import RunCard from "../components/RunCard.astro";
import RunChainCard from "../components/RunChainCard.astro";
import Filters from "../components/Filters.astro";
import type { LoadedRun } from "../lib/results.js";
import {
  chainDepthFor,
  chainRootMatrixId,
  fingerprintByMatrixId,
  formatCost,
  getDataset,
  harnessGroupSlug,
  runCostUsd,
} from "../lib/dataset.js";

const ds = getDataset();
const fpByMatrix = fingerprintByMatrixId(ds.runs.values());
const totalRuns = ds.runs.size;
const completedTasks = ds.tasks.filter((t) => t.runs.length > 0).length;
let totalCost = 0;
let wastedCost = 0;
let totalDurationMs = 0;
let wastedDurationMs = 0;
let costRunCount = 0;
let successCount = 0;
let failedCount = 0;
for (const r of ds.runs.values()) {
  const c = runCostUsd(r.meta);
  if (c !== null) {
    totalCost += c;
    if (r.meta.status !== "success") wastedCost += c;
    costRunCount++;
  }
  totalDurationMs += r.meta.timing.totalMs;
  if (r.meta.status !== "success") {
    wastedDurationMs += r.meta.timing.totalMs;
    failedCount++;
  } else {
    successCount++;
  }
}
const fmtMin = (ms: number) =>
  ms < 60000 ? `${(ms / 1000).toFixed(1)}s` : `${(ms / 60000).toFixed(1)}m`;

/**
 * For each task, fold the run list into one tile per model. If a model has
 * an iter chain, render a RunChainCard with the strip showing root bare →
 * iter-1 → … → iter-N (the root *is* the single-shot bare, so we don't
 * also render it standalone). If a model has only bare results, render a
 * single RunCard.
 *
 * Multiple iter strategies on the same model (e.g. render-png-feedback と
 * future error-text-feedback) は別チェーンとして表示する。
 */
type TaskTile =
  | { kind: "single"; key: string; run: LoadedRun }
  | {
      kind: "chain";
      key: string;
      groupSlug: string;
      steps: Array<{ run: LoadedRun; depth: number }>;
    };

function buildTileRow(taskRuns: LoadedRun[]): {
  tiles: TaskTile[];
  older: number;
} {
  // taskRuns is already newest-first within (matrixId).
  // 1) Pick the latest run per matrixId.
  const latestByMatrix = new Map<string, LoadedRun>();
  for (const r of taskRuns) {
    if (!latestByMatrix.has(r.meta.matrixId)) {
      latestByMatrix.set(r.meta.matrixId, r);
    }
  }
  const older = taskRuns.length - latestByMatrix.size;

  // 2) For each (model, iter group) combination, build a chain tile that
  //    pulls in the root bare. Track which bare matrixIds got absorbed
  //    into a chain so we don't also emit them as standalone tiles.
  const tiles: TaskTile[] = [];
  const absorbedBareMatrixIds = new Set<string>();

  // Collect iter runs grouped by (model, iter slug).
  const iterBuckets = new Map<
    string,
    { groupSlug: string; runs: LoadedRun[] }
  >();
  for (const r of latestByMatrix.values()) {
    const groupSlug = harnessGroupSlug(r.meta);
    if (!groupSlug.startsWith("iter-")) continue;
    const model = r.meta.model ?? "unknown";
    const key = `${model}::${groupSlug}`;
    const b = iterBuckets.get(key) ?? { groupSlug, runs: [] };
    b.runs.push(r);
    iterBuckets.set(key, b);
  }

  for (const [key, { groupSlug, runs }] of iterBuckets.entries()) {
    const rootIds = new Set(
      runs.map((r) => chainRootMatrixId(r.meta.matrixId, fpByMatrix)),
    );
    const rootRuns: LoadedRun[] = [];
    for (const rootMatrixId of rootIds) {
      const root = latestByMatrix.get(rootMatrixId);
      if (root) {
        rootRuns.push(root);
        absorbedBareMatrixIds.add(rootMatrixId);
      }
    }
    const stepRuns = [...rootRuns, ...runs];
    const seen = new Set<string>();
    const dedup: LoadedRun[] = [];
    for (const r of stepRuns) {
      if (seen.has(r.meta.matrixId)) continue;
      seen.add(r.meta.matrixId);
      dedup.push(r);
    }
    const steps = dedup
      .map((r) => ({ run: r, depth: chainDepthFor(r.meta.matrixId, fpByMatrix) }))
      .sort((a, b) => a.depth - b.depth);
    tiles.push({ kind: "chain", key, groupSlug, steps });
  }

  // Standalone single-shot tiles for non-iter runs whose bare is NOT already
  // absorbed into a chain card.
  for (const r of latestByMatrix.values()) {
    const groupSlug = harnessGroupSlug(r.meta);
    if (groupSlug.startsWith("iter-")) continue;
    if (absorbedBareMatrixIds.has(r.meta.matrixId)) continue;
    tiles.push({
      kind: "single",
      key: `single::${r.meta.matrixId}`,
      run: r,
    });
  }

  // Singles first (alphabetical-ish via insertion order = matrixId order),
  // chains after — same as before.
  tiles.sort((a, b) => {
    const ka = a.kind === "chain" ? 1 : 0;
    const kb = b.kind === "chain" ? 1 : 0;
    return ka - kb;
  });
  return { tiles, older };
}

const taskRows = ds.tasks.map((t) => {
  const { tiles, older } = buildTileRow(t.runs);
  return { task: t.task, tiles, older };
});
---

<Base title="vibe-openscad — dashboard">
  <h1>3D 空間認識ベンチマーク</h1>
  <p class="muted">
    複数の AI モデル / ハーネスに同じ課題で OpenSCAD コードを生成させ、結果を横並びで比較する。
  </p>
  <div class="stats">
    <div class="stat">
      <div class="label">課題</div>
      <div class="val">{completedTasks} / {ds.tasks.length}</div>
    </div>
    <div class="stat">
      <div class="label">run</div>
      <div class="val">{totalRuns} <span class="sub">({successCount} ok / {failedCount} fail)</span></div>
    </div>
    <div class="stat">
      <div class="label">累計コスト</div>
      <div class="val">{formatCost(totalCost)}{wastedCost > 0 && <span class="sub wasted"> 内 {formatCost(wastedCost)} は失敗</span>}</div>
    </div>
    <div class="stat">
      <div class="label">累計時間</div>
      <div class="val">{fmtMin(totalDurationMs)}{wastedDurationMs > 0 && <span class="sub wasted"> 内 {fmtMin(wastedDurationMs)} は失敗</span>}</div>
    </div>
  </div>

  <Filters
    models={ds.facets.models.toSorted()}
    harnessKinds={ds.facets.harnessKinds.toSorted()}
    tiers={ds.facets.tiers}
    subagentModels={ds.facets.subagentModels.toSorted()}
  />

  {ds.tasks.length === 0 && (
    <p class="muted">tasks/ にタスク YAML がありません。</p>
  )}

  <div class="task-list">
    {taskRows.map(({ task, tiles, older }) => (
      <section class="task-row" data-tier={String(task.tier)}>
        <header>
          <h2>
            <a href={`/tasks/${task.id}`}>{task.title}</a>
            <span class="badge">tier {task.tier}</span>
            <span class="muted task-id">{task.id}</span>
            {older > 0 && (
              <a class="muted older" href={`/tasks/${task.id}`}>+{older} 過去 run</a>
            )}
          </h2>
        </header>
        {tiles.length === 0 ? (
          <p class="muted empty">まだ run がありません。<code>pnpm bench run</code> で実行してください。</p>
        ) : (
          <div class="grid">
            {tiles.map((tile) =>
              tile.kind === "single" ? (
                <RunCard run={tile.run} tier={task.tier} />
              ) : (
                <RunChainCard
                  steps={tile.steps}
                  groupSlug={tile.groupSlug}
                  tier={task.tier}
                />
              ),
            )}
          </div>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .task-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .task-row header h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
  }
  .task-row .task-id {
    font-family: var(--mono);
    font-size: 12px;
    margin-left: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .empty {
    font-size: 13px;
    padding: 12px;
    background: var(--bg-2);
    border: 1px dashed var(--line);
    border-radius: 6px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin: 16px 0 28px;
  }
  .stat {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
  }
  .stat .label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stat .val {
    font-family: var(--mono);
    font-size: 18px;
    margin-top: 4px;
  }
  .stat .sub {
    font-size: 12px;
    color: var(--fg-dim);
    font-weight: normal;
  }
  .stat .sub.wasted { color: var(--bad); }
  .older {
    font-family: var(--mono);
    font-size: 12px;
    margin-left: auto;
  }
</style>
