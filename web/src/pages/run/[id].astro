---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { resolve } from "node:path";
import Base from "../../layouts/Base.astro";
import ParametricStlViewer from "../../components/ParametricStlViewer.astro";
import RunView from "../../components/RunView.astro";
import { formatCost, getDataset, runCostUsd, shortModelLabel, statusBadgeClass, taskSlug } from "../../lib/dataset.js";
import { extractParameters } from "../../lib/scad-parameters.js";
import Breadcrumb from "../../components/Breadcrumb.astro";

export async function getStaticPaths() {
  const ds = await getDataset();
  const tasksById = new Map(ds.tasks.map((t) => [t.task.id, t.task]));
  const repoRoot = resolve(process.cwd(), "..");
  // Reverse index: runId → list of children that iterate from it.
  const childrenOf = new Map<string, string[]>();
  for (const r of ds.runs.values()) {
    if (r.meta.parentRunId) {
      const list = childrenOf.get(r.meta.parentRunId) ?? [];
      list.push(r.meta.runId);
      childrenOf.set(r.meta.parentRunId, list);
    }
  }
  const out = [];
  for (const [runId, run] of ds.runs.entries()) {
    const task = tasksById.get(run.meta.taskId);
    let scad = "";
    try {
      scad = readFileSync(
        join(repoRoot, "results", run.meta.taskId, runId, "final.scad"),
        "utf8",
      );
    } catch {
      // ignore
    }
    let rawText: string | undefined;
    try {
      rawText = readFileSync(
        join(repoRoot, "results", run.meta.taskId, runId, "raw.txt"),
        "utf8",
      );
    } catch {
      // ignore
    }
    const parameters = scad ? extractParameters(scad) : [];
    const parentRun = run.meta.parentRunId
      ? ds.runs.get(run.meta.parentRunId)
      : undefined;
    const childIds = childrenOf.get(runId) ?? [];
    const children = childIds
      .map((id) => ds.runs.get(id))
      .filter((r): r is NonNullable<typeof r> => !!r);
    out.push({
      params: { id: runId },
      props: {
        run,
        task,
        scad,
        ...(rawText !== undefined ? { rawText } : {}),
        parameters,
        parentRun,
        children,
      },
    });
  }
  return out;
}

const { run, task, scad, rawText, parameters, parentRun, children } = Astro.props;
const m = run.meta;
const tweakable = parameters.filter(
  (p) => p.kind === "number" || p.kind === "boolean",
);
const cost = runCostUsd(m);
const ogTitle = `${m.matrixId} / ${m.taskId}`;
const ogDescription = [
  m.model ? `model: ${m.model}` : null,
  `status: ${m.status}`,
  `time: ${(m.timing.totalMs / 1000).toFixed(1)}s`,
  cost !== null ? `cost: ${formatCost(cost)}` : null,
]
  .filter(Boolean)
  .join(" · ");

const subagents =
  m.harness.kind === "external-agent" ? m.harness.subagents ?? [] : [];
---

<Base
  title={`${ogTitle} — vibe-openscad`}
  description={ogDescription}
  ogImage={run.pngUrl}
  ogType="article"
>
  <Breadcrumb items={[
    { label: "home", href: "/" },
    { label: "task", href: "/task" },
    ...(task
      ? [{ label: m.taskId, href: `/task/${taskSlug(task)}` }]
      : [{ label: m.taskId }]),
    ...(m.model && task
      ? [{ label: shortModelLabel(m.model), href: `/task/${taskSlug(task)}/${m.model}` }]
      : []),
    { label: m.runId.slice(0, 16) + "…" },
  ]} />

  <h1 class="title">
    <span class="matrix">{m.matrixId}</span>
    <span class="muted">/</span>
    <span class="task-id">{m.taskId}</span>
  </h1>
  <div class="badges">
    <span class={statusBadgeClass(m.status)}>{m.status}</span>
    {task && <span class="badge">tier {task.tier}</span>}
    {m.harness.kind === "external-agent" && (
      <span class="badge">{m.harness.agent} {m.harness.agentVersion}</span>
    )}
  </div>

  {m.error && (
    <div class="error-box">
      <div class="label">error</div>
      <pre>{m.error}</pre>
    </div>
  )}

  {run.stlUrl && tweakable.length > 0 ? (
    /* parametric: RunView を ParametricStlViewer で包み、RunView 内の
       STL viewer 位置に viewer-host を slot 経由で差し込む。slider は
       RunView(render + SCAD)の下に出る。 */
    <ParametricStlViewer scad={scad} parameters={parameters}>
      <RunView
        pngUrl={run.pngUrl}
        stlUrl={run.stlUrl}
        scad={scad}
        runId={m.runId}
        status={m.status}
        taskId={m.taskId}
        durationMs={m.timing.totalMs}
        tokens={m.tokens}
        costUsd={cost}
        errorMessage={m.error}
        rawText={rawText}
        title={m.harness.kind}
        subtitle={m.model ? `(${shortModelLabel(m.model)})` : undefined}
        showRunLink={false}
      >
        <Fragment slot="stl-viewer">
          <div class="viewer-host" data-stl-host data-stl-src={run.stlUrl}>
            <div class="overlay loading">loading STL…</div>
          </div>
        </Fragment>
      </RunView>
    </ParametricStlViewer>
  ) : (
    <RunView
      pngUrl={run.pngUrl}
      stlUrl={run.stlUrl}
      scad={scad}
      runId={m.runId}
      status={m.status}
      taskId={m.taskId}
      durationMs={m.timing.totalMs}
      tokens={m.tokens}
      costUsd={cost}
      errorMessage={m.error}
      rawText={rawText}
      title={m.harness.kind}
      subtitle={m.model ? `(${shortModelLabel(m.model)})` : undefined}
      showRunLink={false}
    />
  )}

  <section class="meta-table">
    <h3>meta</h3>
    <table>
      <tbody>
        <tr><th>runId</th><td><code>{m.runId}</code></td></tr>
        <tr><th>matrixId</th><td><code>{m.matrixId}</code></td></tr>
        <tr><th>signature</th><td><code class="trunc" title={m.signature}>{m.signature.slice(0, 16)}…</code></td></tr>
        <tr><th>provider</th><td>{m.provider ?? "—"}</td></tr>
        <tr><th>model</th><td>{m.model ?? "—"}</td></tr>
        <tr><th>harness</th><td>{m.harness.kind}</td></tr>
        {m.harness.kind === "external-agent" && (
          <>
            <tr><th>turns</th><td>{m.harness.turnsUsed} / {m.harness.maxTurns}</td></tr>
            <tr><th>renderCalls</th><td>{m.harness.renderCalls}</td></tr>
          </>
        )}
        <tr><th>status</th><td>{m.status}</td></tr>
        <tr><th>duration</th><td>{(m.timing.totalMs / 1000).toFixed(2)}s <span class="muted small">(wallclock: load + prompt eval + generation + network)</span></td></tr>
        {m.timing.firstTokenMs !== undefined && (
          <tr><th>TTFT</th><td>{(m.timing.firstTokenMs / 1000).toFixed(3)}s</td></tr>
        )}
        {m.timing.generationMs !== undefined && (
          <tr><th>generation time</th><td>{(m.timing.generationMs / 1000).toFixed(2)}s <span class="muted small">(pure decode, excludes load + prompt eval)</span></td></tr>
        )}
        {m.tokens && (
          <tr><th>tokens</th><td>{m.tokens.input} in / {m.tokens.output} out</td></tr>
        )}
        {m.tokens && m.timing.generationMs !== undefined && m.timing.generationMs > 0 && m.tokens.output > 0 && (
          <tr><th>generation tok/s</th><td>{(m.tokens.output / (m.timing.generationMs / 1000)).toFixed(1)} tok/s <span class="muted small">(pure decode rate)</span></td></tr>
        )}
        {m.tokens && m.timing.totalMs > 0 && m.tokens.output > 0 && (
          <tr><th>wallclock tok/s</th><td>{(m.tokens.output / (m.timing.totalMs / 1000)).toFixed(1)} tok/s <span class="muted small">(end-to-end)</span></td></tr>
        )}
        {cost !== null && (
          <tr><th>cost</th><td>{formatCost(cost)}{m.cost_usd === undefined && <span class="muted"> (recomputed)</span>}</td></tr>
        )}
        <tr><th>createdAt</th><td>{m.createdAt}</td></tr>
        {m.gitCommit && (
          <tr><th>gitCommit</th><td><code class="trunc">{m.gitCommit.slice(0, 12)}</code></td></tr>
        )}
        <tr><th>openscad</th><td>{m.fingerprint.openscadVersion}</td></tr>
      </tbody>
    </table>
  </section>

  {(m.harness.kind === "bare" || m.harness.kind === "pdf-page") &&
    m.harness.modelMetadata && (
    <section class="meta-table">
      <h3>model metadata <span class="muted small">(self-hosted)</span></h3>
      <p class="muted small">
        セルフホスト LLM はクラウドの単一 <code>provider</code> と違い、
        実質「(モデル開発者, weight publisher, 量子化)」の組で挙動が決まる。
        run 時に LM Studio / Ollama から取得した値:
      </p>
      <table>
        <tbody>
          {m.harness.modelMetadata.publisher && (
            <tr><th>publisher</th><td><code>{m.harness.modelMetadata.publisher}</code></td></tr>
          )}
          {m.harness.modelMetadata.type && (
            <tr><th>type</th><td>{m.harness.modelMetadata.type}</td></tr>
          )}
          {m.harness.modelMetadata.arch && (
            <tr><th>arch</th><td>{m.harness.modelMetadata.arch}</td></tr>
          )}
          {m.harness.modelMetadata.quantization && (
            <tr><th>quantization</th><td><code>{m.harness.modelMetadata.quantization}</code></td></tr>
          )}
          {m.harness.modelMetadata.parameterSize && (
            <tr><th>parameter size</th><td>{m.harness.modelMetadata.parameterSize}</td></tr>
          )}
          {m.harness.modelMetadata.maxContextLength && (
            <tr><th>max ctx</th><td>{m.harness.modelMetadata.maxContextLength.toLocaleString()} tok</td></tr>
          )}
          {m.harness.modelMetadata.capabilities && m.harness.modelMetadata.capabilities.length > 0 && (
            <tr><th>capabilities</th><td>{m.harness.modelMetadata.capabilities.join(", ")}</td></tr>
          )}
          {m.harness.modelMetadata.size && (
            <tr><th>size</th><td>{(m.harness.modelMetadata.size / (1024*1024*1024)).toFixed(2)} GB</td></tr>
          )}
          {m.harness.modelMetadata.host?.gpu && (
            <tr><th>host GPU</th><td>{m.harness.modelMetadata.host.gpu}{m.harness.modelMetadata.host.gpuPlatform && <span class="muted small"> ({m.harness.modelMetadata.host.gpuPlatform})</span>}</td></tr>
          )}
          {m.harness.modelMetadata.host?.vramGb !== undefined && (
            <tr><th>host VRAM</th><td>{m.harness.modelMetadata.host.vramGb} GB</td></tr>
          )}
          {m.harness.modelMetadata.host?.cpu && (
            <tr><th>host CPU</th><td>{m.harness.modelMetadata.host.cpu}</td></tr>
          )}
          {m.harness.modelMetadata.host?.memGb !== undefined && (
            <tr><th>host RAM</th><td>{m.harness.modelMetadata.host.memGb} GB</td></tr>
          )}
        </tbody>
      </table>
    </section>
  )}

  {subagents.length > 0 && (
    <section>
      <h3>subagents</h3>
      <table class="subagents">
        <thead>
          <tr><th>name</th><th>role</th><th>provider</th><th>model</th><th>invocations</th><th>tokens</th></tr>
        </thead>
        <tbody>
          {subagents.map((s) => (
            <tr>
              <td><code>{s.name}</code></td>
              <td>{s.role ?? "—"}</td>
              <td>{s.provider ?? "—"}</td>
              <td><code>{s.model}</code></td>
              <td>{s.invocations}</td>
              <td>{s.tokens ? `${s.tokens.input} / ${s.tokens.output}` : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {(parentRun || children.length > 0) && (
    <section>
      <h3>iteration chain</h3>
      <p class="muted hint">
        各 iteration step は独立した benchmark run です。<code>parentRunId</code> で前段にリンクします。
      </p>
      <div class="chain">
        {parentRun && (
          <div class="chain-row">
            <span class="chain-label">← parent</span>
            <a class="chain-card" href={`/run/${parentRun.meta.runId}`}>
              {parentRun.pngUrl && (
                <img src={parentRun.pngUrl} alt={`parent ${parentRun.meta.runId}`} loading="lazy" />
              )}
              <code>{parentRun.meta.matrixId}</code>
              <span class={statusBadgeClass(parentRun.meta.status)}>{parentRun.meta.status}</span>
            </a>
          </div>
        )}
        {children.length > 0 && (
          <div class="chain-row">
            <span class="chain-label">→ children ({children.length})</span>
            <div class="chain-children">
              {children.map((c) => (
                <a class="chain-card" href={`/run/${c.meta.runId}`}>
                  {c.pngUrl && (
                    <img src={c.pngUrl} alt={`child ${c.meta.runId}`} loading="lazy" />
                  )}
                  <code>{c.meta.matrixId}</code>
                  <span class={statusBadgeClass(c.meta.status)}>{c.meta.status}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {task && (
    <section>
      <h3>prompt</h3>
      <pre class="prompt">{task.prompt}</pre>
    </section>
  )}

</Base>

<style>
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-family: var(--mono);
    font-size: 20px;
    margin-bottom: 8px;
  }
  .matrix { color: var(--fg); }
  .task-id { color: var(--fg-dim); }
  .badges {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }
  .meta-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .meta-table th {
    text-align: left;
    padding: 6px 12px 6px 0;
    font-weight: 500;
    color: var(--fg-dim);
    width: 140px;
    vertical-align: top;
  }
  .meta-table td {
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .meta-table tr:last-child td { border-bottom: none; }
  .trunc {
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 280px;
    display: inline-block;
    vertical-align: middle;
  }
  .subagents {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .subagents th, .subagents td {
    text-align: left;
    padding: 6px 12px 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .error-box {
    background: rgba(239, 111, 108, 0.08);
    border: 1px solid rgba(239, 111, 108, 0.4);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
  }
  .error-box .label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--bad);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }
  .error-box pre {
    margin: 0;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--fg);
  }
  .prompt, .scad {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .chain {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .chain-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .chain-label {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-dim);
  }
  .chain-children {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 8px;
  }
  .chain-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px;
    color: var(--fg);
    text-decoration: none;
    font-size: 12px;
  }
  .chain-card:hover { border-color: var(--accent); }
  .chain-card img {
    width: 100%;
    background: var(--render-bg);
    border-radius: 4px;
    border: 1px solid var(--line);
    aspect-ratio: 4/3;
    object-fit: contain;
  }
  .small { font-size: 11px; }
  .hint { font-size: 13px; }
</style>
