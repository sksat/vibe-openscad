---
import Base from "../../layouts/Base.astro";
import RunCard from "../../components/RunCard.astro";
import Filters from "../../components/Filters.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getDataset, taskSlug } from "../../lib/dataset.js";

export async function getStaticPaths() {
  const ds = await getDataset();
  return ds.tasks.map((t) => ({
    params: { slug: taskSlug(t.task) },
    props: {
      task: t.task,
      runs: t.runs,
      facets: ds.facets,
    },
  }));
}

const { task, runs, facets } = Astro.props;

/**
 * OGP 画像はビルド時に `web/scripts/generate-ogp.mjs` が `/og/task-<id>.png`
 * (4 モデルの 2x2 タイル + ヘッダ) を生成する。生成されていない場合は
 * preferred-model fallback で代表 1 枚を選ぶ(= run があるなら必ず何か出る)。
 */
const OGP_PREFERRED_MODELS = [
  "claude-opus-4-7",
  "claude-sonnet-4-6",
  "gpt-5.4-2026-03-05",
  "gpt-5-2025-08-07",
  "gemini-3.1-pro-preview",
  "gemini-2.5-pro",
];
import { existsSync } from "node:fs";
import { resolve as pathResolve } from "node:path";
const syntheticOgpPath = `/og/task-${task.id}.png`;
const syntheticOgpExists = existsSync(
  pathResolve(process.cwd(), "public", syntheticOgpPath.slice(1)),
);
function pickFallbackOgpImage(): string | undefined {
  const bareDefault = runs.filter(
    (r) => r.pngUrl && r.meta.matrixId.startsWith("bare/"),
  );
  for (const model of OGP_PREFERRED_MODELS) {
    const hit = bareDefault.find((r) => r.meta.model === model);
    if (hit?.pngUrl) return hit.pngUrl;
  }
  return bareDefault[0]?.pngUrl ?? runs.find((r) => r.pngUrl)?.pngUrl;
}
const sampleImage = syntheticOgpExists
  ? syntheticOgpPath
  : pickFallbackOgpImage();
const description = `${task.title} (tier ${task.tier}) — ${runs.length} run の比較`;
---

<Base
  title={`${task.title} — vibe-openscad`}
  description={description}
  ogImage={sampleImage}
>
  <Breadcrumb items={[
    { label: "home", href: "/" },
    { label: "task", href: "/task" },
    { label: task.id },
  ]} />
  <h1>{task.title}</h1>
  <div class="meta">
    <span class="badge">tier {task.tier}</span>
    <code>{task.id}</code>
  </div>

  <h2>プロンプト</h2>
  <pre>{task.prompt}</pre>

  <h2>Runs ({runs.length})</h2>

  <Filters
    models={facets.models.toSorted()}
    harnessKinds={facets.harnessKinds.toSorted()}
    subagentModels={facets.subagentModels.toSorted()}
  />

  {runs.length === 0 ? (
    <p class="muted">まだ run がありません。</p>
  ) : (
    <div class="grid">
      {runs.map((r) => <RunCard run={r} tier={task.tier} />)}
    </div>
  )}
</Base>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .meta code {
    font-size: 13px;
    color: var(--fg-dim);
  }
  details {
    margin: 8px 0 16px;
  }
  details summary {
    cursor: pointer;
    font-size: 13px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
</style>
