---
import type { LoadedRun } from "../lib/results.js";
import {
  formatCost,
  runBadges,
  runCostUsd,
  statusBadgeClass,
} from "../lib/dataset.js";
import VendorIcon from "./VendorIcon.astro";

interface ChainStrategy {
  groupSlug: string;
  /** The chain tail (highest-depth run); used as the chain detail URL key. */
  tail: LoadedRun;
  /** Iter steps depth >= 1, ordered low to high. */
  iterSteps: Array<{ run: LoadedRun; depth: number }>;
}

interface Props {
  /** Single-shot bare run for this (task, model). */
  bare: LoadedRun;
  /**
   * Iteration chains rooted in `bare`. Empty when the model has only a
   * single-shot result. Future strategies (error-text-feedback etc.) become
   * additional rows below the bare image without changing the shape.
   */
  strategies: ChainStrategy[];
  tier?: number;
}

const { bare, strategies, tier } = Astro.props;
const m = bare.meta;
// Aggregate stats across bare + every iter step.
let totalMs = m.timing.totalMs;
let totalCost = runCostUsd(m) ?? 0;
let totalIn = m.tokens?.input ?? 0;
let totalOut = m.tokens?.output ?? 0;
let stepCount = 1;
let hasCost = runCostUsd(m) !== null;
for (const s of strategies) {
  for (const st of s.iterSteps) {
    totalMs += st.run.meta.timing.totalMs;
    const c = runCostUsd(st.run.meta);
    if (c !== null) {
      totalCost += c;
      hasCost = true;
    }
    if (st.run.meta.tokens) {
      totalIn += st.run.meta.tokens.input;
      totalOut += st.run.meta.tokens.output;
    }
    stepCount++;
  }
}
const segments = runBadges(m);
const dataModels = m.model ?? "";
// bare サムネのクリック先: 単独の chain がある場合はその detail に飛ぶ。
// 複数 strategy があるケースは将来的に「model 全体の overview」ページを
// 作る余地があるが、現状は最初の strategy の chain detail に着地させる。
const bareHref =
  strategies.length > 0
    ? `/chains/${strategies[0]!.tail.meta.runId}`
    : `/benchmark/${m.runId}`;
const bareAriaLabel =
  strategies.length > 0
    ? `open chain detail for ${m.model ?? m.matrixId}`
    : `open bare run ${m.runId}`;
---

<article
  class="chain-card"
  data-model={dataModels}
  data-provider={m.provider ?? ""}
  data-harness={m.harness.kind}
  data-matrix={m.matrixId}
  data-status={m.status}
  data-task={m.taskId}
  data-tier={tier !== undefined ? String(tier) : ""}
>
  <div class="bare-wrap" data-status={m.status}>
    <a class="bare-link" href={bareHref} aria-label={bareAriaLabel}>
      {bare.pngUrl ? (
        <div class="bare-thumb"><img src={bare.pngUrl} alt={`bare render of ${m.taskId}`} loading="lazy" /></div>
      ) : (
        <div class="bare-thumb empty"><span>no render</span></div>
      )}
      <span class="bare-label">bare</span>
    </a>
    <div class="bare-overlay" title={m.matrixId}>
      {segments.map((s) => {
        const inner = (
          <Fragment>
            {s.kind === "vendor" && s.vendor && <VendorIcon vendor={s.vendor} />}
            {s.label}
          </Fragment>
        );
        let href: string | null = null;
        if (s.href) href = s.href;
        else if (s.kind === "model" && m.model) href = `/models/${m.model}`;
        else if (s.kind === "harness") href = `/harnesses/${s.label}`;
        if (href) {
          return (
            <a class={`pill pill-${s.kind}`} data-vendor={s.vendor ?? ""} title={s.title ?? s.label} href={href}>
              {inner}
            </a>
          );
        }
        return (
          <span class={`pill pill-${s.kind}`} data-vendor={s.vendor ?? ""} title={s.title ?? s.label}>
            {inner}
          </span>
        );
      })}
    </div>
  </div>

  {strategies.map((s) => {
    const tailMeta = s.tail.meta;
    return (
      <div class="strategy-row" data-strategy={s.groupSlug}>
        <a
          class="strategy-label"
          href={`/chains/${tailMeta.runId}`}
          title={`open ${s.groupSlug} chain detail`}
        >
          <code>{s.groupSlug}</code>
          <span class={`${statusBadgeClass(tailMeta.status)} mini`}>{tailMeta.status}</span>
        </a>
        <div class="strategy-strip">
          {s.iterSteps.map((st) => {
            const sm = st.run.meta;
            return (
              <a
                class="iter-thumb"
                href={`/benchmark/${sm.runId}`}
                aria-label={`open iter ${st.depth} run ${sm.runId}`}
                data-status={sm.status}
              >
                {st.run.pngUrl ? (
                  <img src={st.run.pngUrl} alt={`iter ${st.depth}`} loading="lazy" />
                ) : (
                  <span class="muted">·</span>
                )}
                <span class="iter-label">i{st.depth}</span>
              </a>
            );
          })}
        </div>
      </div>
    );
  })}

  <div class="meta">
    <div class="row sub muted">
      <span>{stepCount} step</span>
      <span>{(totalMs / 1000).toFixed(1)}s</span>
      {totalIn + totalOut > 0 && <span>{totalIn}/{totalOut}t</span>}
      {hasCost && <span class="cost">{formatCost(totalCost)}</span>}
    </div>
  </div>
</article>

<style>
  .chain-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .bare-wrap {
    position: relative;
  }
  .bare-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .bare-thumb {
    aspect-ratio: 4 / 3;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bare-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .bare-thumb.empty {
    background: var(--bg-3);
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 12px;
  }
  .bare-label {
    position: absolute;
    top: 6px;
    left: 6px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-family: var(--mono);
    font-size: 11px;
    padding: 1px 7px;
    border-radius: 3px;
    pointer-events: none;
  }
  .bare-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 6px 8px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 60%, rgba(0, 0, 0, 0));
    /* gradient itself doesn't capture clicks; pills inside re-enable. */
    pointer-events: none;
  }
  .bare-overlay > * { pointer-events: auto; }
  .bare-wrap[data-status="render_error"]::after,
  .bare-wrap[data-status="no_code"]::after,
  .bare-wrap[data-status="submit_missing"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(239, 111, 108, 0.25);
    pointer-events: none;
  }
  .bare-link:hover .bare-thumb {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .strategy-row {
    display: grid;
    grid-template-columns: minmax(72px, auto) 1fr;
    gap: 6px;
    padding: 6px 8px;
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .strategy-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-dim);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .strategy-label code {
    color: var(--fg);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
  }
  .strategy-label:hover code { color: var(--accent); }
  .strategy-label .mini {
    font-size: 10px;
    padding: 0 5px;
    width: fit-content;
  }
  .strategy-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1px;
    background: var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .iter-thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    aspect-ratio: 1 / 1;
    text-decoration: none;
    color: inherit;
  }
  .iter-thumb img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .iter-thumb .muted {
    color: #888;
    font-family: var(--mono);
    font-size: 12px;
  }
  .iter-label {
    position: absolute;
    bottom: 2px;
    left: 2px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-family: var(--mono);
    font-size: 9px;
    padding: 0 4px;
    border-radius: 2px;
    line-height: 1.5;
  }
  .iter-thumb[data-status="render_error"]::after,
  .iter-thumb[data-status="no_code"]::after,
  .iter-thumb[data-status="submit_missing"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(239, 111, 108, 0.25);
    pointer-events: none;
  }
  .iter-thumb:hover { outline: 2px solid var(--accent); outline-offset: -2px; z-index: 1; }

  .meta {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }
  .matrix-row { align-items: flex-start; }
  .matrix-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .pill {
    display: inline-block;
    padding: 1px 7px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    background: var(--bg-3);
    border: 1px solid var(--line);
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .pill-harness { color: var(--fg); border-color: rgba(108, 182, 255, 0.3); }
  .pill-model { color: var(--fg); background: rgba(108, 182, 255, 0.1); border-color: rgba(108, 182, 255, 0.4); }
  .pill-vendor[data-vendor="claude"] { color: #f3a585; border-color: rgba(217, 119, 87, 0.5); background: rgba(217, 119, 87, 0.14); }
  .pill-vendor[data-vendor="gemini"] { color: #d6bcfa; border-color: rgba(139, 92, 246, 0.5); background: rgba(139, 92, 246, 0.14); }
  .pill-vendor[data-vendor="openai"] { color: #5ed5b3; border-color: rgba(16, 163, 127, 0.55); background: rgba(16, 163, 127, 0.14); }
  .sub { font-size: 11px; }
  .cost { font-variant-numeric: tabular-nums; color: var(--fg); }
</style>
