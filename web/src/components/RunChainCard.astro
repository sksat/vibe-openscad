---
import type { LoadedRun } from "../lib/results.js";
import {
  formatCost,
  runBadges,
  runCostUsd,
  statusBadgeClass,
} from "../lib/dataset.js";
import VendorIcon from "./VendorIcon.astro";

interface ChainStep {
  run: LoadedRun;
  depth: number;
}

interface Props {
  /** Chain steps in depth order (root = depth 0 → newest tail). */
  steps: ChainStep[];
  /** Slug shown as a tag — e.g. "iter-png". */
  groupSlug: string;
  tier?: number;
}

const { steps, groupSlug, tier } = Astro.props;
// Aggregate stats across all steps.
let totalMs = 0;
let totalCost = 0;
let totalIn = 0;
let totalOut = 0;
let hasCost = false;
for (const s of steps) {
  totalMs += s.run.meta.timing.totalMs;
  const c = runCostUsd(s.run.meta);
  if (c !== null) {
    totalCost += c;
    hasCost = true;
  }
  if (s.run.meta.tokens) {
    totalIn += s.run.meta.tokens.input;
    totalOut += s.run.meta.tokens.output;
  }
}
const tail = steps[steps.length - 1]!;
const tailMeta = tail.run.meta;
const segments = runBadges(tailMeta);
---

<article
  class="chain-card"
  data-model={tailMeta.model ?? ""}
  data-provider={tailMeta.provider ?? ""}
  data-harness={tailMeta.harness.kind}
  data-matrix={tailMeta.matrixId}
  data-status={tailMeta.status}
  data-task={tailMeta.taskId}
  data-tier={tier !== undefined ? String(tier) : ""}
  data-group={groupSlug}
>
  <div class="strip">
    {steps.map((s) => {
      const m = s.run.meta;
      const lbl = s.depth === 0 ? "bare" : `i${s.depth}`;
      return (
        <a
          class="step"
          href={`/benchmark/${m.runId}`}
          aria-label={`open ${lbl} run ${m.runId}`}
          data-status={m.status}
        >
          <div class="step-thumb">
            {s.run.pngUrl ? (
              <img src={s.run.pngUrl} alt={`render of ${m.taskId} ${lbl}`} loading="lazy" />
            ) : (
              <span class="muted">no render</span>
            )}
          </div>
          <span class="step-label">{lbl}</span>
        </a>
      );
    })}
  </div>
  <div class="meta">
    <div class="row matrix-row">
      <div class="matrix-badges" title={tailMeta.matrixId}>
        {segments.map((s) => {
          const inner = (
            <Fragment>
              {s.kind === "vendor" && s.vendor && <VendorIcon vendor={s.vendor} />}
              {s.label}
            </Fragment>
          );
          let href: string | null = null;
          if (s.href) href = s.href;
          else if (s.kind === "model" && tailMeta.model)
            href = `/models/${tailMeta.model}`;
          else if (s.kind === "harness") href = `/harnesses/${s.label}`;
          if (href) {
            return (
              <a
                class={`pill pill-${s.kind}`}
                data-vendor={s.vendor ?? ""}
                title={s.title ?? s.label}
                href={href}
              >{inner}</a>
            );
          }
          return (
            <span
              class={`pill pill-${s.kind}`}
              data-vendor={s.vendor ?? ""}
              title={s.title ?? s.label}
            >{inner}</span>
          );
        })}
      </div>
      <a
        class={`${statusBadgeClass(tailMeta.status)} status-link`}
        href={`/benchmark/${tailMeta.runId}`}
      >{tailMeta.status}</a>
    </div>
    <div class="row sub muted">
      <span>{steps.length} step</span>
      <span>{(totalMs / 1000).toFixed(1)}s</span>
      {totalIn + totalOut > 0 && <span>{totalIn}/{totalOut}t</span>}
      {hasCost && <span class="cost">{formatCost(totalCost)}</span>}
    </div>
  </div>
</article>

<style>
  .chain-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1px;
    background: var(--line);
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
    color: inherit;
    text-decoration: none;
  }
  .step-thumb {
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }
  .step-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .step-thumb .muted {
    font-family: var(--mono);
    font-size: 10px;
    color: #888;
  }
  .step-label {
    position: absolute;
    bottom: 4px;
    left: 4px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-family: var(--mono);
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 3px;
    line-height: 1.4;
  }
  .step[data-status="render_error"]::after,
  .step[data-status="no_code"]::after,
  .step[data-status="submit_missing"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(239, 111, 108, 0.25);
    pointer-events: none;
  }
  .step:hover .step-thumb {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .meta {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }
  .matrix-row { align-items: flex-start; }
  .matrix-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .pill {
    display: inline-block;
    padding: 1px 7px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    background: var(--bg-3);
    border: 1px solid var(--line);
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .pill-harness {
    color: var(--fg);
    border-color: rgba(108, 182, 255, 0.3);
  }
  .pill-model {
    color: var(--fg);
    background: rgba(108, 182, 255, 0.1);
    border-color: rgba(108, 182, 255, 0.4);
  }
  .pill-vendor[data-vendor="claude"] {
    color: #f3a585;
    border-color: rgba(217, 119, 87, 0.5);
    background: rgba(217, 119, 87, 0.14);
  }
  .pill-vendor[data-vendor="gemini"] {
    color: #d6bcfa;
    border-color: rgba(139, 92, 246, 0.5);
    background: rgba(139, 92, 246, 0.14);
  }
  .pill-vendor[data-vendor="openai"] {
    color: #5ed5b3;
    border-color: rgba(16, 163, 127, 0.55);
    background: rgba(16, 163, 127, 0.14);
  }
  .sub { font-size: 11px; }
  .cost { font-variant-numeric: tabular-nums; color: var(--fg); }
  .status-link { text-decoration: none; }
</style>
