---
import { formatCost } from "../lib/dataset.js";
import ScadCode from "./ScadCode.astro";

interface Props {
  pngUrl: string | undefined;
  scad: string;
  runId: string;
  status: string;
  taskId: string;
  durationMs: number;
  tokens?: { input: number; output: number } | undefined;
  costUsd?: number | null | undefined;
  errorMessage?: string | undefined;
  /** LLM が出した生 text(prose + fences + code 全部)。あれば SCAD/raw
   *  切替トグルが表示される。 */
  rawText?: string | undefined;
}

const {
  pngUrl,
  scad,
  runId,
  status,
  taskId,
  durationMs,
  tokens,
  costUsd,
  errorMessage,
  rawText,
} = Astro.props;
const lines = scad.split("\n").length;
const rawLines = rawText ? rawText.split("\n").length : 0;
const hasRaw = typeof rawText === "string" && rawText.length > 0;
---

<section class="bare-section">
  <header>
    <h2>bare <span class="muted small">(provider default effort)</span></h2>
    <a class="muted runlink" href={`/benchmark/${runId}`}>run detail →</a>
  </header>
  <div class="bare-body">
    <div class="bare-render-col">
      <div class="col-label muted small">render</div>
      <div class="render-frame" data-status={status}>
        {pngUrl ? (
          <img src={pngUrl} alt={`bare render of ${taskId}`} />
        ) : (
          <span class="no-render muted">no render</span>
        )}
      </div>
      <div class="render-meta">
        <div class="row">
          <span class={`status-pill status-${status}`}>{status}</span>
          <span class="muted small">
            {(durationMs / 1000).toFixed(1)}s
            {tokens && ` · ${tokens.input}/${tokens.output}t`}
            {typeof costUsd === "number" && ` · ${formatCost(costUsd)}`}
          </span>
        </div>
        {errorMessage && (
          <pre class="error-detail">{errorMessage}</pre>
        )}
      </div>
    </div>
    <div class="bare-scad-col" data-active-view="scad">
      <div class="col-label scad-meta muted small">
        <span class="scad-meta-text">SCAD ({lines} lines)</span>
        {hasRaw && (
          <span class="view-toggle" role="tablist" aria-label="display mode">
            <button type="button" class="toggle-btn" data-target="scad" aria-pressed="true">SCAD</button>
            <button type="button" class="toggle-btn" data-target="raw" aria-pressed="false">raw ({rawLines} lines)</button>
          </span>
        )}
      </div>
      <div class="scad-scroll" data-view="scad">
        {scad ? <ScadCode scad={scad} errorMessage={errorMessage} /> : <p class="muted small">no SCAD</p>}
      </div>
      {hasRaw && (
        <div class="scad-scroll raw-scroll" data-view="raw" hidden aria-hidden="true">
          <pre class="raw-text"><code>{rawText}</code></pre>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .bare-section header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }
  .bare-section h2 {
    font-family: var(--mono);
    font-size: 15px;
    margin: 0;
  }
  .runlink { font-size: 12px; margin-left: auto; }

  .bare-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .bare-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .bare-render-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  /* render-frame は画像有無に関わらず同じ 4:3 ボックスを保つ。 */
  .render-frame {
    aspect-ratio: 4 / 3;
    width: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .render-frame img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .render-frame[data-status]:not([data-status="success"]) {
    background: var(--bg-3);
    border-style: dashed;
  }
  .no-render {
    font-family: var(--mono);
    font-size: 13px;
  }

  .render-meta { display: flex; flex-direction: column; gap: 6px; }
  .render-meta .row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .status-pill {
    display: inline-block;
    padding: 1px 8px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    border: 1px solid var(--line);
    background: var(--bg-3);
    color: var(--fg-dim);
  }
  .status-pill.status-success {
    color: var(--ok);
    border-color: rgba(108, 213, 140, 0.4);
    background: rgba(108, 213, 140, 0.08);
  }
  .status-pill.status-render_error,
  .status-pill.status-no_code,
  .status-pill.status-submit_missing,
  .status-pill.status-timeout,
  .status-pill.status-api_error {
    color: var(--bad);
    border-color: rgba(239, 111, 108, 0.4);
    background: rgba(239, 111, 108, 0.08);
  }
  .error-detail {
    font-size: 11px;
    color: var(--bad);
    background: rgba(239, 111, 108, 0.06);
    border: 1px solid rgba(239, 111, 108, 0.4);
    border-radius: 4px;
    padding: 6px 10px;
    margin: 0;
    max-height: 160px;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .bare-scad-col {
    display: flex;
    flex-direction: column;
    /* render col と同じ gap を当てて col-label の下端から bordered box
       までの距離を揃える(同じ y 座標で box が始まる)。 */
    gap: 10px;
    min-width: 0;
    /* container query 単位を SCAD col の幅基準にする。container-type を
       grid 親 (.bare-body) に置くと sibling col の aspect-ratio が
       崩れる Chromium 挙動があったため、ここに scope する。 */
    container-type: inline-size;
  }
  /* SCAD scroll max は 1.5 × column-width (= 2 × render-frame height,
     render が aspect 4/3 で 0.75 × col-width のため)。100cqw =
     bare-scad-col 幅。150cqw でちょうど render の倍を狙う。 */
  .scad-scroll {
    /* SCAD ファイルの規模を視覚化するため縦バーは常時表示。横は wrap
       済みなので必要時のみ。 */
    overflow-y: scroll;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-2);
    max-height: 150cqw;
    /* Firefox 用 */
    scrollbar-color: var(--fg-dim) var(--bg-3);
    scrollbar-width: auto;
  }
  /* Chromium / WebKit 用に太めのスクロールバーを明示 */
  .scad-scroll::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }
  .scad-scroll::-webkit-scrollbar-track {
    background: var(--bg-3);
    border-radius: 6px;
  }
  .scad-scroll::-webkit-scrollbar-thumb {
    background: var(--fg-dim);
    border-radius: 6px;
    border: 2px solid var(--bg-3);
  }
  .scad-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--fg);
  }
  .scad-scroll::-webkit-scrollbar-corner {
    background: var(--bg-3);
  }
  /* モバイル(1 列レイアウト)では bare-scad-col 幅 ≒ viewport 幅、
     150cqw だと縦に伸びすぎるので vh で抑える。 */
  @media (max-width: 719px) {
    .scad-scroll { max-height: 60vh; }
  }
  /* render 列と SCAD 列の上端ラベル。両方同じ高さで scroll の top と
     render-frame の top が揃う。 */
  .col-label {
    padding: 4px 0 6px;
    font-family: var(--mono);
    line-height: 1.3;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .scad-meta-text { flex: 0 0 auto; }
  .view-toggle {
    margin-left: auto;
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .toggle-btn {
    background: var(--bg-3);
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 11px;
    border: none;
    padding: 2px 8px;
    cursor: pointer;
  }
  .toggle-btn + .toggle-btn { border-left: 1px solid var(--line); }
  .toggle-btn:hover { color: var(--fg); }
  .toggle-btn[aria-pressed="true"] {
    background: rgba(108, 182, 255, 0.15);
    color: var(--accent);
  }
  .raw-text {
    margin: 0;
    padding: 12px;
    background: var(--bg-2);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 12px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  /* Shiki の <pre> はデフォで padding (~1em) を持ち、これが残ると
     \"first line of code\" が render-frame top より下から始まる。両 col の
     最上端を厳密に揃えるためにゼロにし、必要な余白は :global の :first-child
     等で抑える。横方向の余白は scroll コンテナの padding で確保する。 */
  .scad-scroll :global(pre) {
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
  }
  /* コード自体は左にちょっと余白がほしい(1 文字目が border に
     張り付かないように)が、上は 0 で render-frame と揃える。 */
  .scad-scroll :global(pre code) {
    display: block;
    padding: 0 12px 12px;
  }
</style>

<script>
  // SCAD / raw 切替。各 .bare-scad-col 単独の島として動作する。
  for (const col of document.querySelectorAll<HTMLElement>(".bare-scad-col")) {
    const buttons = col.querySelectorAll<HTMLButtonElement>(".toggle-btn");
    const views = col.querySelectorAll<HTMLElement>("[data-view]");
    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        const target = btn.dataset["target"];
        if (!target) return;
        col.setAttribute("data-active-view", target);
        for (const b of buttons) {
          b.setAttribute(
            "aria-pressed",
            b.dataset["target"] === target ? "true" : "false",
          );
        }
        for (const v of views) {
          const visible = v.dataset["view"] === target;
          if (visible) {
            v.removeAttribute("hidden");
            v.removeAttribute("aria-hidden");
          } else {
            v.setAttribute("hidden", "");
            v.setAttribute("aria-hidden", "true");
          }
        }
      });
    }
  }
</script>
