---
import type { LoadedRun } from "../lib/results.js";
import { formatCost, runCostUsd } from "../lib/dataset.js";
import RunThumb from "./RunThumb.astro";

interface Props {
  run: LoadedRun;
  showTask?: boolean;
  tier?: number;
}
const { run, showTask = false, tier } = Astro.props;
const m = run.meta;
const subagentModels =
  m.harness.kind === "external-agent" && m.harness.subagents
    ? m.harness.subagents.map((s) => s.model)
    : [];
const dataModels = [m.model, ...subagentModels].filter(Boolean).join(",");
const cost = runCostUsd(m);
---

<article
  class="run-card"
  data-model={m.model ?? ""}
  data-models={dataModels}
  data-provider={m.provider ?? ""}
  data-harness={m.harness.kind}
  data-matrix={m.matrixId}
  data-status={m.status}
  data-task={m.taskId}
  data-tier={tier !== undefined ? String(tier) : ""}
>
  <RunThumb run={run} alt={`render of ${m.taskId} by ${m.matrixId}`} />
  <div class="meta">
    {showTask && <div class="task muted">{m.taskId}</div>}
    <div class="row sub muted">
      <span>{(m.timing.totalMs / 1000).toFixed(1)}s</span>
      {m.tokens && (
        <span>{m.tokens.input}/{m.tokens.output}t</span>
      )}
      {cost != null && <span class="cost">{formatCost(cost)}</span>}
    </div>
    {subagentModels.length > 0 && (
      <div class="row sub muted">
        <span>+ subagents: {subagentModels.join(", ")}</span>
      </div>
    )}
  </div>
</article>

<style>
  .run-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    color: var(--fg);
    transition: transform 0.05s ease, border-color 0.1s ease;
  }
  .run-card:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .meta {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }
  .task {
    font-family: var(--mono);
    font-size: 12px;
  }
  .sub { font-size: 11px; }
  .cost {
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
</style>
