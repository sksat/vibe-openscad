---
export interface Crumb {
  label: string;
  /** Omit on the current/last item — that one renders as plain text with aria-current="page". */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="breadcrumb" class="crumb-nav">
  <ol>
    {items.map((c, i) => {
      const isLast = i === items.length - 1;
      return (
        <li>
          {!isLast && c.href ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
          {!isLast && <span class="sep" aria-hidden="true">›</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .crumb-nav {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-dim);
    margin-bottom: 12px;
  }
  .crumb-nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .crumb-nav li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .crumb-nav a {
    color: var(--fg-dim);
    text-decoration: none;
  }
  .crumb-nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .crumb-nav [aria-current="page"] {
    color: var(--fg);
    font-weight: 500;
  }
  .crumb-nav .sep {
    color: var(--line);
  }
</style>
