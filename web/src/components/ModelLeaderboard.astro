---
import type { LeaderboardData, LeaderboardRow } from "../lib/leaderboard.js";
import {
  formatCost,
  modelVendorIcon,
  shortModelLabel,
} from "../lib/dataset.js";
import VendorIcon from "./VendorIcon.astro";

interface Props {
  data: LeaderboardData;
}
const { data } = Astro.props;
const { tasks, rows } = data;

/** ％ 表記(0..1 → 0..100 整数)。 */
const pct = (r: number) => Math.round(r * 100);
/** レイテンシをコンパクトに。 */
function fmtLat(ms: number): string {
  if (ms < 1000) return `${Math.round(ms)}ms`;
  if (ms < 60000) return `${(ms / 1000).toFixed(ms < 10000 ? 1 : 0)}s`;
  return `${(ms / 60000).toFixed(1)}m`;
}

// バー幅: コスト・レイテンシは値域が桁違いに広い(数秒〜十数分 /
// $0.0001〜$0.1)。線形 + 単純 max だと「1 サンプルだけの外れ値」1 行が
// スケールを支配して大半の行が潰れ、バーが空に見える。対策として
//  (1) サンプルの薄い行(tasksAttempted < 3)を min/max 算出から除外し、
//  (2) min..max の対数スケールで幅を割り当てる(短い=速い/安い=良い)。
// 数値ラベルは常に併記しているので、バーは「相対的な大小の目安」に徹する。
const wellSampled = rows.filter((r) => r.tasksAttempted >= 3);
function posValues(sel: (r: LeaderboardRow) => number | null): number[] {
  const pick = (rs: LeaderboardRow[]) =>
    rs.map(sel).filter((v): v is number => v != null && v > 0);
  const robust = pick(wellSampled);
  return robust.length > 1 ? robust : pick(rows);
}
const latVals = posValues((r) => r.avgLatencyMs);
const costVals = posValues((r) => r.avgCostUsd);
const minLat = latVals.length ? Math.min(...latVals) : 0;
const maxLat = latVals.length ? Math.max(...latVals) : 0;
const minCost = costVals.length ? Math.min(...costVals) : 0;
const maxCost = costVals.length ? Math.max(...costVals) : 0;
function barW(v: number | null, min: number, max: number): string {
  if (v == null) return "0%";
  if (min <= 0 || !(max > min)) return "50%";
  const f = (Math.log(v) - Math.log(min)) / (Math.log(max) - Math.log(min));
  return `${Math.min(100, Math.max(3, Math.round(f * 100)))}%`;
}

// data-rank 用: モデル順(既定ソートではなく「モデル順」ボタンが使う順)。
// rows は既に success 降順なので、モデル順は别途インデックスを振る。
const rankIndex = new Map<string, number>();
[...rows]
  .map((r) => r.model)
  .sort((a, b) => a.localeCompare(b))
  .forEach((m, i) => rankIndex.set(m, i));

// 色は3値(success=緑 / render_error+no_code=赤 / submit_missing+timeout=橙)
// なので凡例も色に合わせて3グループに畳む。さもないと「5色で見分けられる」
// と誤解させる(実際の配色は dataset.ts の重大度グルーピングに対応)。
const STATUS_LEGEND: { status: string; label: string }[] = [
  { status: "success", label: "success" },
  { status: "render_error", label: "render_error / no_code" },
  { status: "submit_missing", label: "submit_missing / timeout" },
];

function cellMeta(run: NonNullable<Props["data"]["rows"][number]["cells"][number]["run"]>): string {
  const m = run.meta;
  const parts = [m.status, fmtLat(m.timing.totalMs)];
  if (m.tokens) parts.push(`${m.tokens.input}/${m.tokens.output}t`);
  return parts.join(" · ");
}
---

<div class="lb" data-lb-root style={`--ncols:${tasks.length}`}>
  <div class="lb-controls">
    <div class="ctl-group">
      <span class="ctl-label">sort</span>
      <div class="sort-btns">
        <button type="button" class="sort-btn active" data-sort-key="success" data-default-dir="desc">成功率</button>
        <button type="button" class="sort-btn" data-sort-key="cost" data-default-dir="asc">コスト</button>
        <button type="button" class="sort-btn" data-sort-key="latency" data-default-dir="asc">レイテンシ</button>
        <button type="button" class="sort-btn" data-sort-key="tasks" data-default-dir="desc">試行数</button>
        <button type="button" class="sort-btn" data-sort-key="rank" data-default-dir="asc">モデル順</button>
      </div>
    </div>
    <div class="ctl-group legend">
      <span class="ctl-label">status</span>
      {STATUS_LEGEND.map((s) => (
        <span class="legend-item" data-status={s.status}><i class="swatch"></i>{s.label}</span>
      ))}
    </div>
  </div>

  <!-- タスク凡例: 右のサムネ帯の列番号 ①②… を task 名にデコードする。
       列ヘッダは番号だけにして、識別はここで取る。 -->
  <div class="task-legend" aria-label="タスク凡例">
    <span class="ctl-label">tasks</span>
    {tasks.map((t, i) => (
      <span class="tl-item" data-tier={t.tier} title={`${t.title}(tier ${t.tier})`}>
        <span class="tl-num">{i + 1}</span>
        <span class="tl-name">{t.slug}</span>
      </span>
    ))}
    <span class="tl-note muted">枠色 = <span class="t2">tier2</span> / <span class="t3">tier3</span></span>
  </div>

  <div class="lb-scroll">
    <table class="lb-table">
      <thead>
        <tr>
          <th class="c-rank">#</th>
          <th class="c-model">model</th>
          <th class="c-ok">成功率</th>
          <th class="c-num">試行</th>
          <th class="c-bar">平均レイテンシ<span class="dir">短い=速い</span></th>
          <th class="c-bar">平均コスト<span class="dir">短い=安い</span></th>
          <th class="c-strip">
            <div class="strip-head-label">renders / task</div>
            <div class="strip-head" aria-hidden="true">
              {tasks.map((t, i) => (
                <span class="strip-head-cell" data-tier={t.tier} title={`${t.title}(tier ${t.tier})`}>
                  <span class="sh-num">{i + 1}</span>
                </span>
              ))}
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => {
          const vendor = modelVendorIcon(row.model);
          return (
            <tr
              data-success={row.successRate != null ? String(row.successRate) : ""}
              data-cost={row.avgCostUsd != null ? String(row.avgCostUsd) : ""}
              data-latency={row.avgLatencyMs != null ? String(row.avgLatencyMs) : ""}
              data-tasks={String(row.tasksAttempted)}
              data-runs={String(row.totalRuns)}
              data-rank={String(rankIndex.get(row.model) ?? 999)}
              data-name={row.model}
            >
              <td class="c-rank"><span class="rank-n"></span></td>
              <td class="c-model">
                <a class="model-link" href={`/models/${row.model}`} title={row.model}>
                  {vendor && <VendorIcon vendor={vendor} size={13} />}
                  <span class="model-name">{shortModelLabel(row.model)}</span>
                </a>
                <div class="model-sub muted">{row.totalRuns} run{row.tasksAttempted < tasks.length ? ` · ${row.tasksAttempted}/${tasks.length} task` : ""}</div>
              </td>
              <td class="c-ok">
                {row.successRate != null ? (
                  <div class="ok-cell">
                    <div class="ok-bar"><span style={`width:${pct(row.successRate)}%`}></span></div>
                    <div class="ok-text"><strong>{pct(row.successRate)}%</strong> <span class="muted">{row.successCount}/{row.sampleCount}</span></div>
                  </div>
                ) : (
                  <span class="muted">—</span>
                )}
              </td>
              <td class="c-num">{row.tasksAttempted}</td>
              <td class="c-bar">
                {row.avgLatencyMs != null ? (
                  <div class="mbar-cell">
                    <div class="mbar lat"><span style={`width:${barW(row.avgLatencyMs, minLat, maxLat)}`}></span></div>
                    <span class="mbar-text">{fmtLat(row.avgLatencyMs)}</span>
                  </div>
                ) : (
                  <span class="muted">—</span>
                )}
              </td>
              <td class="c-bar">
                {row.avgCostUsd != null ? (
                  <div class="mbar-cell">
                    <div class="mbar cost"><span style={`width:${barW(row.avgCostUsd, minCost, maxCost)}`}></span></div>
                    <span class="mbar-text">{formatCost(row.avgCostUsd)}</span>
                  </div>
                ) : (
                  <span class="muted">—</span>
                )}
              </td>
              <td class="c-strip">
                <div class="task-strip">
                  {row.cells.map((cell, ci) => {
                    if (cell.run && cell.run.pngUrl) {
                      const m = cell.run.meta;
                      return (
                        <button
                          type="button"
                          class="lb-thumb"
                          data-status={cell.status}
                          data-col={String(ci)}
                          data-img={cell.run.pngUrl}
                          data-model={row.model}
                          data-task={cell.task.title}
                          data-status-text={cell.status}
                          data-meta={cellMeta(cell.run)}
                          data-href={`/run/${m.runId}`}
                          title={`${cell.task.title} — ${cell.status}`}
                          aria-label={`${row.model} on ${cell.task.title}: ${cell.status}`}
                        >
                          <img src={cell.run.pngUrl} alt={`${row.model} / ${cell.task.title}`} loading="lazy" />
                        </button>
                      );
                    }
                    if (cell.run) {
                      // run はあるが render 無し(no_code 等)。
                      return (
                        <div class="lb-thumb norender" data-status={cell.status} data-col={String(ci)} title={`${cell.task.title} — ${cell.status}`}>
                          <span class="x">×</span>
                        </div>
                      );
                    }
                    return (
                      <div class="lb-thumb empty" data-col={String(ci)} title={`${cell.task.title} — 未実行`}>
                        <span class="dash">·</span>
                      </div>
                    );
                  })}
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- 拡大ライトボックス: サムネクリックで開く。←→ 同一モデルの別タスク、
       ↑↓ 同一タスクの別モデルへ移動できる(直接 A/B 比較用)。 -->
  <div class="lightbox" data-lightbox hidden>
    <div class="lb-backdrop" data-lb-close></div>
    <figure class="lb-figure" role="dialog" aria-modal="true" aria-label="レンダ拡大プレビュー" tabindex="-1">
      <button type="button" class="lb-nav prev" data-lb-prev aria-label="前(←)">‹</button>
      <img class="lb-img" alt="" />
      <button type="button" class="lb-nav next" data-lb-next aria-label="次(→)">›</button>
      <figcaption class="lb-cap">
        <div class="lb-cap-row">
          <strong class="lb-model"></strong>
          <span class="lb-status" data-status=""></span>
        </div>
        <div class="lb-cap-row muted"><span class="lb-task"></span> · <span class="lb-meta"></span></div>
        <a class="lb-link" href="#">run 詳細 →</a>
        <div class="lb-hint muted">←→ モデル内のタスク移動 · ↑↓ 同一タスクのモデル移動 · Esc 閉じる</div>
      </figcaption>
      <button type="button" class="lb-close" data-lb-close aria-label="閉じる">×</button>
    </figure>
  </div>
</div>

<script>
  /* ─── ソート ─────────────────────────────────────────────
     行に data-success / data-cost / data-latency / data-tasks / data-rank /
     data-name を持たせ、ボタンで tbody を並べ替える。空値は常に最下段。 */
  (function () {
    const root = document.querySelector<HTMLElement>("[data-lb-root]");
    if (!root) return;
    const tbody = root.querySelector("tbody");
    if (!tbody) return;
    let activeKey = "success";
    let dir: 1 | -1 = -1; // success desc

    function cellVal(tr: HTMLElement, key: string): number | string | null {
      const v = tr.dataset[key];
      if (v === undefined || v === "") return null;
      if (key === "name") return v;
      const n = Number(v);
      return Number.isNaN(n) ? null : n;
    }
    function sortBy(key: string, defaultDir: "asc" | "desc") {
      if (activeKey === key) dir = (dir * -1) as 1 | -1;
      else {
        activeKey = key;
        dir = defaultDir === "asc" ? 1 : -1;
      }
      const rows = Array.from(tbody!.querySelectorAll<HTMLElement>("tr"));
      rows.sort((a, b) => {
        const va = cellVal(a, key);
        const vb = cellVal(b, key);
        if (va === null && vb === null) return 0;
        if (va === null) return 1; // nulls last regardless of dir
        if (vb === null) return -1;
        if (typeof va === "string" || typeof vb === "string") {
          return dir * String(va).localeCompare(String(vb));
        }
        return dir * (va - vb);
      });
      for (const r of rows) tbody!.appendChild(r);
      for (const btn of root!.querySelectorAll<HTMLElement>(".sort-btn")) {
        const on = btn.dataset.sortKey === key;
        btn.classList.toggle("active", on);
        btn.dataset.dir = on ? (dir === 1 ? "asc" : "desc") : "";
      }
    }
    root.querySelectorAll<HTMLElement>(".sort-btn").forEach((btn) => {
      btn.addEventListener("click", () =>
        sortBy(btn.dataset.sortKey!, (btn.dataset.defaultDir as "asc" | "desc") ?? "desc"),
      );
    });
  })();

  /* ─── ライトボックス ─────────────────────────────────── */
  (function () {
    const lb = document.querySelector<HTMLElement>("[data-lightbox]");
    if (!lb) return;
    const img = lb.querySelector<HTMLImageElement>(".lb-img")!;
    const elModel = lb.querySelector<HTMLElement>(".lb-model")!;
    const elTask = lb.querySelector<HTMLElement>(".lb-task")!;
    const elStatus = lb.querySelector<HTMLElement>(".lb-status")!;
    const elMeta = lb.querySelector<HTMLElement>(".lb-meta")!;
    const elLink = lb.querySelector<HTMLAnchorElement>(".lb-link")!;
    const figure = lb.querySelector<HTMLElement>(".lb-figure")!;
    let current: HTMLElement | null = null;
    let opener: HTMLElement | null = null;
    function focusables(): HTMLElement[] {
      return Array.from(
        figure.querySelectorAll<HTMLElement>(
          'button, a[href], [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute("disabled") && el.offsetParent !== null);
    }

    function render(t: HTMLElement) {
      current = t;
      img.src = t.dataset.img ?? "";
      img.alt = `${t.dataset.model} / ${t.dataset.task}`;
      elModel.textContent = t.dataset.model ?? "";
      elTask.textContent = t.dataset.task ?? "";
      elStatus.textContent = t.dataset.statusText ?? "";
      elStatus.dataset.status = t.dataset.statusText ?? "";
      elMeta.textContent = t.dataset.meta ?? "";
      elLink.href = t.dataset.href ?? "#";
    }
    function open(t: HTMLElement) {
      opener = document.activeElement as HTMLElement | null;
      render(t);
      lb!.removeAttribute("hidden");
      document.body.style.overflow = "hidden";
      // フォーカスをダイアログ内へ移す(キーボード/SR がモーダル操作に到達できる)。
      (lb!.querySelector<HTMLElement>(".lb-close") ?? figure).focus();
    }
    function close() {
      lb!.setAttribute("hidden", "");
      document.body.style.overflow = "";
      current = null;
      // 起点要素にフォーカスを戻す。
      opener?.focus?.();
      opener = null;
    }
    function visibleRows(): HTMLElement[] {
      return Array.from(
        document.querySelectorAll<HTMLElement>("tbody tr"),
      ).filter((r) => r.style.display !== "none");
    }
    function rowSiblings(t: HTMLElement): HTMLElement[] {
      const tr = t.closest("tr");
      if (!tr) return [t];
      return Array.from(tr.querySelectorAll<HTMLElement>(".lb-thumb[data-img]"));
    }
    function colSiblings(t: HTMLElement): HTMLElement[] {
      const col = t.dataset.col;
      const out: HTMLElement[] = [];
      for (const r of visibleRows()) {
        const c = r.querySelector<HTMLElement>(
          `.lb-thumb[data-img][data-col="${col}"]`,
        );
        if (c) out.push(c);
      }
      return out;
    }
    function move(list: HTMLElement[], delta: number) {
      if (!current) return;
      const i = list.indexOf(current);
      if (i < 0) return;
      const next = list[i + delta];
      if (next) render(next);
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const th = target.closest<HTMLElement>(".lb-thumb[data-img]");
      if (th) {
        e.preventDefault();
        open(th);
        return;
      }
      if (target.closest("[data-lb-close]")) close();
    });
    lb.querySelector("[data-lb-prev]")!.addEventListener("click", (e) => {
      e.stopPropagation();
      if (current) move(rowSiblings(current), -1);
    });
    lb.querySelector("[data-lb-next]")!.addEventListener("click", (e) => {
      e.stopPropagation();
      if (current) move(rowSiblings(current), 1);
    });
    document.addEventListener("keydown", (e) => {
      if (lb!.hasAttribute("hidden")) return;
      if (e.key === "Tab") {
        // フォーカストラップ: ダイアログ内の focusable を循環させ、背景へ抜けない。
        const f = focusables();
        if (f.length === 0) {
          e.preventDefault();
          return;
        }
        const first = f[0]!;
        const last = f[f.length - 1]!;
        const active = document.activeElement as HTMLElement | null;
        const inside = active ? figure.contains(active) : false;
        if (e.shiftKey && (active === first || !inside)) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (active === last || !inside)) {
          e.preventDefault();
          first.focus();
        }
        return;
      }
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft" && current) move(rowSiblings(current), -1);
      else if (e.key === "ArrowRight" && current) move(rowSiblings(current), 1);
      else if (e.key === "ArrowUp" && current) {
        e.preventDefault();
        move(colSiblings(current), -1);
      } else if (e.key === "ArrowDown" && current) {
        e.preventDefault();
        move(colSiblings(current), 1);
      }
    });
  })();
</script>

<style>
  /* サムネは列を var(--thumb) の固定幅にして全行で縦に揃え、列方向に
     1 タスクをモデル横断で見比べられるようにする。 */
  .lb {
    --thumb: 44px;
    --strip-gap: 3px;
    --row-pad: 7px 10px;
  }
  .lb-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    padding: 10px 14px;
    margin-bottom: 14px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .ctl-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ctl-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sort-btns {
    display: flex;
    gap: 4px;
  }
  .sort-btn {
    background: var(--bg-3);
    color: var(--fg-dim);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    font-family: var(--mono);
    font-size: 11px;
    cursor: pointer;
  }
  .sort-btn:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .sort-btn.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }
  .sort-btn.active[data-dir="asc"]::after { content: " ▲"; }
  .sort-btn.active[data-dir="desc"]::after { content: " ▼"; }
  .legend {
    margin-left: auto;
    flex-wrap: wrap;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg-dim);
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1px solid var(--line);
    display: inline-block;
  }
  .legend-item[data-status="success"] .swatch { background: var(--ok); }
  .legend-item[data-status="render_error"] .swatch,
  .legend-item[data-status="no_code"] .swatch { background: var(--bad); }
  .legend-item[data-status="submit_missing"] .swatch,
  .legend-item[data-status="timeout"] .swatch { background: var(--warn); }

  /* 高さを拘束して内部スクロールコンテナにすることで sticky thead を実際に
     効かせる(overflow-x:auto だけだと縦スクロールは document 側で起き、
     ヘッダが一緒に流れて固定されない)。横スクロールもこのコンテナ内。 */
  .lb-scroll {
    overflow: auto;
    max-height: calc(100vh - 150px);
  }
  .lb-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 13px;
  }
  .lb-table thead th {
    position: sticky;
    top: 0;
    z-index: 3;
    background: var(--bg-3);
    border-bottom: 2px solid var(--accent);
    text-align: left;
    font-weight: 600;
    color: var(--fg);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    padding: 9px 10px;
    white-space: nowrap;
  }
  /* 横スクロールしてもモデルが分かるよう # と model 列を左 sticky 化。
     sticky セルは不透明背景が必須(下に流れる内容を隠す)。zebra/hover に
     合わせた実色を当てる。 */
  .lb-table .c-rank,
  .lb-table .c-model {
    position: sticky;
    z-index: 1;
    background: var(--bg);
  }
  .lb-table .c-rank { left: 0; }
  .lb-table .c-model { left: 34px; }
  .lb-table tbody tr:nth-child(even) .c-rank,
  .lb-table tbody tr:nth-child(even) .c-model { background: #181b20; }
  .lb-table tbody tr:hover .c-rank,
  .lb-table tbody tr:hover .c-model { background: #16202b; }
  /* 左 sticky 列の見出しは「縦×横」両 sticky の角セルなので最前面に。 */
  .lb-table thead th.c-rank,
  .lb-table thead th.c-model { z-index: 4; background: var(--bg-3); }
  /* メトリクス列とサムネ帯の境界を明示。 */
