---
import type { LoadedRun } from "../lib/results.js";
import { formatCost, runBadges, runCostUsd } from "../lib/dataset.js";
import VendorIcon from "./VendorIcon.astro";

/** Short error tag for non-success iter statuses. Returns null on success. */
function errorBadgeFor(status: string): string | null {
  switch (status) {
    case "render_error":
      return "render";
    case "no_code":
      return "nocode";
    case "submit_missing":
      return "nosub";
    case "timeout":
      return "timeout";
    case "api_error":
      return "api";
    default:
      return null;
  }
}

interface ChainStrategy {
  groupSlug: string;
  /** The chain tail (highest-depth run); used as the chain detail URL key. */
  tail: LoadedRun;
  /** Iter steps depth >= 1, ordered low to high. */
  iterSteps: Array<{ run: LoadedRun; depth: number }>;
  /**
   * 期待される chain 全長(他モデル含む同 strategy の最大 depth)。
   * 未実行 / chain-break のところは placeholder で埋めて全 card の
   * iter strip 幅を揃える。
   */
  expectedDepth: number;
}

/**
 * 並列バリアント一覧(reasoning effort など)。各バリアントは独立な run で、
 * 親子関係はない。一行に label + サムネ列で表示。
 */
interface VariantRow {
  /** 行ヘッダ(例: \"effort\")。 */
  familySlug: string;
  /** 全 model 横断で取りうる label の正規順(card 幅を揃えるためにこれで pad)。 */
  expectedLabels: string[];
  /** モデル固有のバリアント。expectedLabels に対応する位置に詰める。
   *  isDefault=true は provider 既定値の run(明示的指定なし)を示す。 */
  variants: Array<{ label: string; run: LoadedRun; isDefault?: boolean }>;
}

interface Props {
  /** Single-shot bare run for this (task, model). */
  bare: LoadedRun;
  /**
   * Iteration chains rooted in `bare`. Empty when the model has only a
   * single-shot result. Future strategies (error-text-feedback etc.) become
   * additional rows below the bare image without changing the shape.
   */
  strategies: ChainStrategy[];
  /**
   * 並列バリアント行(reasoning effort など)。各行は独立に表示される。
   */
  variantRows?: VariantRow[];
  tier?: number;
  /** URL に使う task slug。`meta.taskId` (内部 id) と独立に親が解決する。
   *  未指定なら taskId をそのまま使う(下位互換)。 */
  taskSlug?: string;
}

const { bare, strategies, variantRows = [], tier, taskSlug } = Astro.props;
const m = bare.meta;
// Aggregate stats across bare + every iter step.
let totalMs = m.timing.totalMs;
let totalCost = runCostUsd(m) ?? 0;
let totalIn = m.tokens?.input ?? 0;
let totalOut = m.tokens?.output ?? 0;
let stepCount = 1;
let hasCost = runCostUsd(m) !== null;
const accumulate = (run: LoadedRun) => {
  totalMs += run.meta.timing.totalMs;
  const c = runCostUsd(run.meta);
  if (c !== null) {
    totalCost += c;
    hasCost = true;
  }
  if (run.meta.tokens) {
    totalIn += run.meta.tokens.input;
    totalOut += run.meta.tokens.output;
  }
  stepCount++;
};
for (const s of strategies) for (const st of s.iterSteps) accumulate(st.run);
for (const row of variantRows) for (const v of row.variants) accumulate(v.run);
const segments = runBadges(m);
const dataModels = m.model ?? "";
// bare サムネ / strategy ラベルクリック先: card 全体の detail
// (= /task/<task>/<model>/)。bare run 単独の detail は detail 上の
// \"run detail →\" から到達できる。
const cardHref =
  m.model != null
    ? `/task/${taskSlug ?? m.taskId}/${m.model}`
    : `/run/${m.runId}`;
const bareAriaLabel = `open card detail for ${m.taskId} on ${m.model ?? m.matrixId}`;
---

<article
  class="model-task-card"
  data-model={dataModels}
  data-provider={m.provider ?? ""}
  data-harness={m.harness.kind}
  data-matrix={m.matrixId}
  data-status={m.status}
  data-task={m.taskId}
  data-tier={tier !== undefined ? String(tier) : ""}
>
  <div class="bare-wrap" data-status={m.status}>
    <a class="bare-link" href={cardHref} aria-label={bareAriaLabel}>
      {bare.pngUrl ? (
        <div class="bare-thumb"><img src={bare.pngUrl} alt={`bare render of ${m.taskId}`} loading="lazy" /></div>
      ) : (
        <div class="bare-thumb empty"><span>no render</span></div>
      )}
    </a>
    {(() => {
      const renderPill = (s: typeof segments[number]) => {
        const inner = (
          <Fragment>
            {s.kind === "vendor" && s.vendor && <VendorIcon vendor={s.vendor} />}
            {s.label}
          </Fragment>
        );
        let href: string | null = null;
        if (s.href) href = s.href;
        else if (s.kind === "model" && m.model) href = `/models/${m.model}`;
        else if (s.kind === "harness") href = `/harnesses/${s.label}`;
        if (href) {
          return (
            <a class={`pill pill-${s.kind}`} data-vendor={s.vendor ?? ""} title={s.title ?? s.label} href={href}>
              {inner}
            </a>
          );
        }
        return (
          <span class={`pill pill-${s.kind}`} data-vendor={s.vendor ?? ""} title={s.title ?? s.label}>
            {inner}
          </span>
        );
      };
      const harnessPills = segments.filter((s) => s.kind === "harness");
      const idPills = segments.filter((s) => s.kind === "vendor" || s.kind === "model");
      return (
        <div class="bare-overlay" title={m.matrixId}>
          {harnessPills.length > 0 && (
            <div class="overlay-row">
              {harnessPills.map((s) => renderPill(s))}
            </div>
          )}
          {idPills.length > 0 && (
            <div class="overlay-row">
              {idPills.map((s) => renderPill(s))}
            </div>
          )}
        </div>
      );
    })()}
  </div>

  {variantRows.map((row) => {
    const labelLines = row.familySlug.split("-");
    return (
    <div class="strategy-row variant-row" data-family={row.familySlug}>
      <span class="strategy-label">
        {labelLines.map((line) => <code>{line}</code>)}
      </span>
      <div class="strategy-strip">
        {row.expectedLabels.map((lbl) => {
          const v = row.variants.find((x) => x.label === lbl);
          if (!v) {
            return (
              <div class="iter-thumb placeholder" title={`${row.familySlug}=${lbl} not run`} aria-label={`${row.familySlug}=${lbl} not run`}>
                <span class="iter-label">{lbl}</span>
              </div>
            );
          }
          const sm = v.run.meta;
          const errBadge = errorBadgeFor(sm.status);
          const cost = runCostUsd(sm);
          return (
            <a
              class="iter-thumb"
              href={`/run/${sm.runId}`}
              aria-label={`open ${row.familySlug}=${lbl} run ${sm.runId}`}
              data-status={sm.status}
            >
              {v.run.pngUrl ? (
                <img src={v.run.pngUrl} alt={`${row.familySlug}=${lbl}`} loading="lazy" />
              ) : (
                <span class="muted">·</span>
              )}
              <span class="iter-label">{lbl}{v.isDefault ? <span class="default-mark">*</span> : null}</span>
              {errBadge && <span class="iter-err">{errBadge}</span>}
              <div class="hover-card" role="tooltip">
                {v.run.pngUrl && (
                  <img class="hover-img" src={v.run.pngUrl} alt={`${row.familySlug}=${lbl} preview`} loading="lazy" />
                )}
                <div class="hover-meta">
                  <div class="hover-line">
                    <strong>{row.familySlug} = {lbl}{v.isDefault ? " (default)" : ""}</strong>
                    <span class="hover-status" data-status={sm.status}>{sm.status}</span>
                  </div>
                  <div class="hover-line muted">
                    {(sm.timing.totalMs / 1000).toFixed(1)}s
                    {sm.tokens && ` · ${sm.tokens.input}/${sm.tokens.output}t`}
                    {cost !== null && ` · ${formatCost(cost)}`}
                  </div>
                  {sm.error && <pre class="hover-err">{sm.error}</pre>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  );
  })}

  {strategies.map((s) => {
    const labelLines = s.groupSlug.split("-");
    return (
      <div class="strategy-row" data-strategy={s.groupSlug}>
        <a
          class="strategy-label"
          href={cardHref}
          title={`open ${s.groupSlug} chain in card detail`}
        >
          {labelLines.map((line) => <code>{line}</code>)}
        </a>
        <div class="strategy-strip">
          {Array.from({ length: s.expectedDepth }, (_, idx) => idx + 1).map((d) => {
            const step = s.iterSteps.find((st) => st.depth === d);
            if (!step) {
              return (
                <div
                  class="iter-thumb placeholder"
                  title={`iter ${d} not run`}
                  aria-label={`iter ${d} not run`}
                >
                  <span class="iter-label">i{d}</span>
                </div>
              );
            }
            const sm = step.run.meta;
            const errBadge = errorBadgeFor(sm.status);
            const cost = runCostUsd(sm);
            return (
              <a
                class="iter-thumb"
                href={`/run/${sm.runId}`}
                aria-label={`open iter ${d} run ${sm.runId}`}
                data-status={sm.status}
              >
                {step.run.pngUrl ? (
                  <img src={step.run.pngUrl} alt={`iter ${d}`} loading="lazy" />
                ) : (
                  <span class="muted">·</span>
                )}
                <span class="iter-label">i{d}</span>
                {errBadge && <span class="iter-err">{errBadge}</span>}
                <div class="hover-card" role="tooltip">
                  {step.run.pngUrl && (
                    <img class="hover-img" src={step.run.pngUrl} alt={`iter ${d} preview`} loading="lazy" />
                  )}
                  <div class="hover-meta">
                    <div class="hover-line">
                      <strong>iter {d}</strong>
                      <span class="hover-status" data-status={sm.status}>{sm.status}</span>
                    </div>
                    <div class="hover-line muted">
                      {(sm.timing.totalMs / 1000).toFixed(1)}s
                      {sm.tokens && ` · ${sm.tokens.input}/${sm.tokens.output}t`}
                      {cost !== null && ` · ${formatCost(cost)}`}
                    </div>
                    {sm.error && <pre class="hover-err">{sm.error}</pre>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    );
  })}

  <div class="meta">
    <div class="row sub muted">
      <span>{stepCount} step</span>
      <span>{(totalMs / 1000).toFixed(1)}s</span>
      {totalIn + totalOut > 0 && <span>{totalIn}/{totalOut}t</span>}
      {hasCost && <span class="cost">{formatCost(totalCost)}</span>}
    </div>
  </div>
</article>

<style>
  .model-task-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .bare-wrap {
    position: relative;
  }
  .bare-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .bare-thumb {
    aspect-ratio: 4 / 3;
    background: var(--render-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bare-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .bare-thumb.empty {
    background: var(--bg-3);
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 12px;
  }
  .bare-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 6px 8px;
    pointer-events: none;
  }
  .bare-overlay .overlay-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .bare-overlay .pill { pointer-events: auto; }
  /* Pills must stay readable on white render thumbnails — force opaque
     dark base + colored borders/text instead of the translucent fills
     used in the bottom-meta context. */
  .bare-overlay .pill {
    background: rgba(20, 25, 32, 0.92);
    backdrop-filter: blur(2px);
    color: var(--fg);
  }
  .bare-overlay .pill-vendor[data-vendor="claude"] {
    color: #f3a585;
    border-color: rgba(217, 119, 87, 0.7);
  }
  .bare-overlay .pill-vendor[data-vendor="gemini"] {
    color: #d6bcfa;
    border-color: rgba(139, 92, 246, 0.7);
  }
  .bare-overlay .pill-vendor[data-vendor="openai"] {
    color: #5ed5b3;
    border-color: rgba(16, 163, 127, 0.7);
  }
  .bare-overlay .pill-model {
    color: var(--fg);
    border-color: rgba(108, 182, 255, 0.5);
  }
  .bare-wrap[data-status="render_error"]::after,
  .bare-wrap[data-status="no_code"]::after,
  .bare-wrap[data-status="submit_missing"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(239, 111, 108, 0.25);
    pointer-events: none;
  }
  .bare-link:hover .bare-thumb {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* 全 row で固定の label 列幅。最長想定の "effort" / "iter-png" の各行が
     収まる + 余白。これで effort 行と iter-png 行の strip 開始位置が揃う。 */
  .strategy-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 6px;
    padding: 4px 6px 4px 8px;
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .strategy-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg-dim);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.15;
    min-width: 0;
  }
  .strategy-label code {
    color: var(--fg);
    font-size: 10px;
    white-space: nowrap;
  }
  .strategy-label:hover code { color: var(--accent); }
  .strategy-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1px;
    background: var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .iter-thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--render-bg);
    aspect-ratio: 1 / 1;
    text-decoration: none;
    color: inherit;
  }
  .iter-thumb img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .iter-thumb .muted {
    color: #888;
    font-family: var(--mono);
    font-size: 12px;
  }
  .iter-label {
    position: absolute;
    bottom: 2px;
    left: 2px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-family: var(--mono);
    font-size: 9px;
    padding: 0 4px;
    border-radius: 2px;
    line-height: 1.5;
  }
  .default-mark {
    color: var(--accent);
    margin-left: 1px;
  }
  .iter-thumb[data-status="render_error"]::after,
  .iter-thumb[data-status="no_code"]::after,
  .iter-thumb[data-status="submit_missing"]::after,
  .iter-thumb[data-status="timeout"]::after,
  .iter-thumb[data-status="api_error"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(239, 111, 108, 0.25);
    pointer-events: none;
  }
  .iter-thumb:hover { outline: 2px solid var(--accent); outline-offset: -2px; z-index: 1; }

  /* hover-card popover: iter サムネにマウス載せたら大きいプレビュー + meta */
  .iter-thumb .hover-card {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    background: var(--bg-2);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
    display: none;
    z-index: 50;
    pointer-events: none;
    font-family: var(--mono);
  }
  .iter-thumb:hover .hover-card { display: block; }
  /* card 全体が overflow:hidden だとはみ出した hover-card が消えるので
     hover 中だけ親を visible に */
  .model-task-card:has(.iter-thumb:hover) { overflow: visible; }
  .strategy-strip:has(.iter-thumb:hover) { overflow: visible; }
  .hover-img {
    width: 100%;
    background: var(--render-bg);
    border-radius: 4px;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    display: block;
    margin-bottom: 4px;
  }
  .hover-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 10px;
    line-height: 1.35;
  }
  .hover-line {
    display: flex;
    justify-content: space-between;
    gap: 6px;
  }
  .hover-status {
    color: var(--ok);
  }
  .hover-status[data-status="render_error"],
  .hover-status[data-status="no_code"],
  .hover-status[data-status="submit_missing"],
  .hover-status[data-status="timeout"],
  .hover-status[data-status="api_error"] {
    color: var(--bad);
  }
  .hover-err {
    margin: 0;
    font-size: 9px;
    color: var(--bad);
    background: rgba(239, 111, 108, 0.06);
    border: 1px solid rgba(239, 111, 108, 0.4);
    padding: 4px 6px;
    max-height: 80px;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    pointer-events: auto;
  }
  .iter-thumb.placeholder {
    background: var(--bg-3);
    color: var(--fg-dim);
    cursor: default;
  }
  .iter-thumb.placeholder .iter-label {
    background: rgba(0, 0, 0, 0.3);
    color: rgba(255, 255, 255, 0.6);
  }
  .iter-err {
    position: absolute;
    top: 2px;
    right: 2px;
    background: rgba(239, 111, 108, 0.9);
    color: #fff;
    font-family: var(--mono);
    font-size: 9px;
    padding: 0 4px;
    border-radius: 2px;
    line-height: 1.5;
    pointer-events: none;
  }

  .meta {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }
  .matrix-row { align-items: flex-start; }
  .matrix-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .pill {
    display: inline-block;
    padding: 1px 7px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    background: var(--bg-3);
    border: 1px solid var(--line);
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .pill-harness { color: var(--fg); border-color: rgba(108, 182, 255, 0.3); }
  .pill-model { color: var(--fg); background: rgba(108, 182, 255, 0.1); border-color: rgba(108, 182, 255, 0.4); }
  .pill-vendor[data-vendor="claude"] { color: #f3a585; border-color: rgba(217, 119, 87, 0.5); background: rgba(217, 119, 87, 0.14); }
  .pill-vendor[data-vendor="gemini"] { color: #d6bcfa; border-color: rgba(139, 92, 246, 0.5); background: rgba(139, 92, 246, 0.14); }
  .pill-vendor[data-vendor="openai"] { color: #5ed5b3; border-color: rgba(16, 163, 127, 0.55); background: rgba(16, 163, 127, 0.14); }
  .sub { font-size: 11px; }
  .cost { font-variant-numeric: tabular-nums; color: var(--fg); }
</style>
