---
interface Props {
  title: string;
  description?: string;
  ogImage?: string | undefined;
  ogType?: "website" | "article";
}
const {
  title,
  description = "AI モデルに同じ課題で OpenSCAD コードを書かせ、3D 空間認識を比較するベンチマーク。",
  ogImage,
  ogType = "website",
} = Astro.props;

const siteName = "vibe-openscad";
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const absoluteOgImage =
  ogImage && Astro.site ? new URL(ogImage, Astro.site).href : ogImage;

// Google Analytics 4 measurement ID. Set PUBLIC_GA_ID at build time
// (.env or CI env). Empty / unset → analytics disabled.
const gaId = (import.meta.env["PUBLIC_GA_ID"] ?? "").trim();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

    <!-- Twitter / X card -->
    <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="brand">vibe-openscad</a>
      <nav>
        <a href="/">dashboard</a>
      </nav>
      <a
        class="repo-link"
        href="https://github.com/sksat/vibe-openscad"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
    </header>
    <main>
      <slot />
    </main>

    <style is:global>
      :root {
        --bg: #0e1116;
        --bg-2: #161b22;
        --bg-3: #1f262e;
        --fg: #d6dee8;
        --fg-dim: #8a96a3;
        --line: #2a323b;
        --accent: #6cb6ff;
        --ok: #6cd58c;
        --warn: #e8b86d;
        --bad: #ef6f6c;
        --mono: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
        --sans: ui-sans-serif, system-ui, "Hiragino Sans", "Yu Gothic", sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: 1.5;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code, pre { font-family: var(--mono); }
      pre {
        background: var(--bg-2);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 12px;
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.45;
      }
      .topbar {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 12px 24px;
        background: var(--bg-2);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .brand {
        font-family: var(--mono);
        font-weight: 600;
        font-size: 14px;
        color: var(--fg);
      }
      .topbar nav a {
        font-size: 13px;
        color: var(--fg-dim);
      }
      .repo-link {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        color: var(--fg-dim);
        transition: color 0.1s ease;
      }
      .repo-link:hover { color: var(--fg); text-decoration: none; }
      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
      }
      h1 { font-size: 24px; margin: 0 0 8px; }
      h2 { font-size: 18px; margin: 24px 0 12px; }
      h3 { font-size: 15px; margin: 16px 0 8px; }
      .muted { color: var(--fg-dim); }
      .badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 999px;
        font-family: var(--mono);
        font-size: 11px;
        background: var(--bg-3);
        color: var(--fg-dim);
        border: 1px solid var(--line);
      }
      .badge.ok { color: var(--ok); border-color: rgba(108,213,140,0.4); }
      .badge.warn { color: var(--warn); border-color: rgba(232,184,109,0.4); }
      .badge.bad { color: var(--bad); border-color: rgba(239,111,108,0.4); }
    </style>
  </body>
</html>
